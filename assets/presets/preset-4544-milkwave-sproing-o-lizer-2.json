      "// Sproing-O-lizer",
      "",
      "// 2007.01.22  raron",
      "",
      "",
      "// Width of one bar (spring:P) in nr of samples:",
      "q1 = 32;",
      "",
      "// spring height multiplier",
      "q2 = 20;"
    ],
    "perFrameInitCode": [],
    "perPixelCode": [],
    "waves": [
      {
        "enabled": true,
        "samples": 512,
        "sep": 0,
        "bSpectrum": true,
        "bUseDots": false,
        "bDrawThick": false,
        "bAdditive": false,
        "scaling": 1,
        "smoothing": 0.5,
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1,
        "initCode": [],
        "perFrameCode": [
          null,
          "t1 = 0;",
          "t2 = q1;",
          "t3 = 1/q1;",
          "t4 = q2;"
        ],
        "perPointCode": [
          null,
          "",
          "bar = (sample*512) % t2;",
          "xstep = int(sample*512*t3);",
          "odd = bar % 2;",
          "",
          "t1 = t1 + value1;",
          "",
          "barvalue = if(equal(bar,0),t1,barvalue);",
          "t1 = if(equal(bar,0),0,t1);",
          "",
          "// Try to not draw diagonal line... not working really....",
          "a = if(equal(bar,t2-1),0,a);",
          "a = if(equal(bar,0),0,a);",
          "a = if(equal(bar,1),0,a);",
          "",
          "meter = bar * 0.001953125 * barvalue * t4;",
          "",
          "y = if(equal(bar,0),0.1,0.1 + meter);",
          "x = (xstep - odd) * t2 * 0.001953125;"
        ]
      },
