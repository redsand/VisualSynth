          "n=sample*6.283;",
          "phs=-sample * 0.2;",
          "tm=q1 + phs;",
          "",
          "flip=(flip+1)*below(flip,1);",
          "",
          "xp=0;",
          "yp=flip*0.1 + (sin(tm)*0.5 + 0.5)*0.2;",
          "zp=0;",
          "",
          "//wrist movement;",
          "ang=sin(tm*2)*0.5 +0.5;",
          "",
          "xq=xp;",
          "sinang=sin(ang);cosang=cos(ang);",
          "yq=yp*sinang + zp*cosang;",
          "zq=yp*cosang - zp*sinang;",
          "yq=yp;",
          "zq=zp;",
          "",
          "ang=tm*8;",
          "sinang=sin(ang);cosang=cos(ang);",
          "xp=xq*sinang + yq*cosang;",
          "yp=xq*cosang - yq*sinang;",
          "zp=zq;",
          "",
          "//forearm movement;",
          "zp=zp-0.3;",
          "ang=3.14 + sin(tm*2 - 0.5)*1.5;",
          "sinang=sin(ang);cosang=cos(ang);",
          "xq=xp;",
          "yq=yp*sinang + zp*cosang;",
          "zq=yp*cosang - zp*sinang;",
          "",
          "//upper arm twist",
          "ang=-1.0 + cos(tm*3.1 + 0.5);",
          "sinang=sin(ang);cosang=cos(ang);",
          "xp=xq*sinang + yq*cosang;",
          "yp=xq*cosang - yq*sinang;",
          "zp=zq;",
          "",
          "//upper arm outward;",
          "zp=zp-0.35;",
          "ang=cos(tm*2.3)*1.75 - 1.05;",
          "sinang=sin(ang);cosang=cos(ang);",
          "xq=xp*sinang + zp*cosang;",
          "yq=yp;",
          "zq=xp*cosang - zp*sinang;",
          "",
          "//upper arm up down;",
          "ang=cos(tm)*0.5 - 0.5;",
          "sinang=sin(ang);cosang=cos(ang);",
          "xp=xq;",
          "yp=yq*cosang - zq*sinang;",
          "zp=yq*sinang + zq*cosang;",
          "",
          "//xp=xq;yp=yq;zp=zq;",
          "",
          "",
          "//project into screenspace and draw on screen",
          "zp=zp+2;",
          "xs=xp/zp;",
          "ys=yp/zp;",
          "",
          "x=xs+0.5;",
          "y=ys*1.3+0.5;",
          "",
          "",
          "dx = if(flip,x,dx-x);",
          "dy = if(flip,y,dy-y);",
          "dz = pow(dx*dx+dy*dy,.5);",
          "ang = abs(asin(dx/dz));",
          "cang = if(flip,cang,if(below(dx,0),if(below(dy,0),-ang,3.141592654 + ang),if(below(dy,0),ang,3.141592654 - ang)));",
          "r = .5 + .5*sin(cang);",
          "g = .5 + .5*sin(cang + 1.047197);",
          "b = .5 + .5*sin(cang + 2.094395);",
          "",
          "a=(1-sample)*above(sample,0);",
          ""
        ]
