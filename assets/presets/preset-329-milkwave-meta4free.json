  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  vec2 dither_uv = uv_orig*uTexSize.xy*texsize_noise_lq.zw * 1 + rand_frame.xy;\n\nret = GetPixel(uv) - 0.08;\nvec2 uv1 = uv;\nvec2 d = uTexSize.zw*4;\nvec3 dx = GetBlur1(uv1 + vec2(1,0)*d) - GetBlur1(uv1 - vec2(1,0)*d);\nvec3 dy = GetBlur1(uv1 + vec2(0,1)*d) - GetBlur1(uv1 - vec2(0,1)*d);\nd *= vec2(dx.x,dy.x)*0.4;\nuv1+=d;\n//uv1 = fract(uv1);\nret.x = tex2d(sampler_fc_main, uv1).x;\nret.x -=(GetBlur1(uv1).x-ret.x)*0.05 + 0.004;\n\nret.z = max(length(vec2(dx.x,dy.x))*1.4,GetPixel(mix(uv_orig,uv,-1) - vec2(dx.z,dy.z)*uTexSize.zw*4).z) - 0.004;\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  vec2 uv1 = uv;\nvec2 d = uTexSize.zw*3;\nvec3 dx = GetBlur1(uv1 + vec2(1,0)*d) - GetBlur1(uv1 - vec2(1,0)*d);\nvec3 dy = GetBlur1(uv1 + vec2(0,1)*d) - GetBlur1(uv1 - vec2(0,1)*d);\nuv1 = uv+vec2(dx.x,dy.x)*uTexSize.zw*32;\n     ret = GetPixel(uv1).x*vec3(1,0,0)*0.5;\n\nret.x += (+dx.x - dy.x)*0.4;\nret = pow(ret.x,0.8)*vec3(1.2,0.15,0);\nret = mix(ret,vec3(1,1,1),GetBlur2(uv - vec2(dx.x,dy.x)*uTexSize.zw*128).z*0.6);\n\nret = mix(ret,vec3(1,1.1,1.2),GetPixel(uv1).z);\n\nret = mix(ret,vec3(0.2,0,0.1),GetBlur1(uv - vec2(dx.y,dy.y)*uTexSize.zw*16 - vec2(dx.x,dy.x)*uTexSize.zw*32 ).y*6);\n//ret = GetPixel(uv);\n  fragColor = ret;\n}",
