          "",
          "rad=rad+.2*rad*sin(3.5+10*3.14*sample);",
          "s=5*sample;",
          "",
          "x=if(above(s,0),-1.7+1.5*s,x);",
          "y=if(above(s,0),1.4-3.8*s,y);",
          "",
          "x=if(above(s,1),-2.4+1.2*s,x);",
          "y=if(above(s,1),6.5-4.5*s,y);",
          "",
          "x=if(above(s,2),-2.7+s,x);",
          "y=if(above(s,2),11.8-4.8*s,y);",
          "",
          "x=if(above(s,3),-1.+.4*s,x);",
          "y=if(above(s,3),14.7-4.3*s,y);",
          "",
          "x=if(above(s,4),3.9-.6*s,x);",
          "y=if(above(s,4),8.8-2.2*s,y);",
          "rad=if(above(s,4),1.1*rad,rad);",
          "",
          "z=0;",
          "",
          "/////movement",
          "t=2*time+3*q2;",
          "",
          "f1=above(s,0)*below(s,1);",
          "f2=above(s,1)*below(s,2);",
          "f3=above(s,2)*below(s,3);",
          "f4=above(s,3)*below(s,4);",
          "f5=above(s,4)*below(s,5);",
          "",
          "",
          "z=if(f1, if(above(y,-.3), -.3*abs((y+.3)*sin(t)), z),z);",
          "z=if(f1, if(above(y,.5),z-.4*abs((y-.5)*sin(1.3*t)), z),z);",
          "y=if(f1, if(above(y,.5),y-.3*abs((y-.5)*sin(1.7*t)), y),y);",
          "",
          "z=if(f2, if(above(y,0),z-.3*abs(y*sin(1.2*t)), z),z);",
          "z=if(f2, if(above(y,1.2),z-.3*abs((y-1.2)*sin(1.4*t)), z),z);",
          "y=if(f2, if(above(y,1.2),y-.2*abs((y-1.2)*sin(1.2*t)), y),y);",
          "",
          "z=if(f3, if(above(y,.3),z-.2*abs((y-.3)*sin(1.1*t)), z),z);",
          "z=if(f3, if(above(y,1.5),z-.2*abs((y-1.5)*sin(1.6*t)), z),z);",
          "y=if(f3, if(above(y,1.5),y-.1*abs((y-1.5)*sin(1.3*t)), y),y);",
          "",
          "z=if(f4, if(above(y,.3),z-.2*abs((y-.3)*sin(1.2*t)), z),z);",
          "z=if(f4, if(above(y,1.3),z-.2*abs((y-1.3)*sin(1.2*t)), z),z);",
          "y=if(f4, if(above(y,1.3),y-.2*abs((y-1.3)*sin(1.1*t)), y),y);",
          "",
          "x=if(f5, if(above(y,-.7),x-.4*abs((y+.7)*sin(1.2*t)), x),x);",
          "x=if(f5, if(above(y,0),x-.7*abs(y*sin(1.*t)), x),x);",
          "z=if(f5, if(above(y,0),z-.1*abs(y*sin(1.0*t)), z),z);",
          "y=if(f5, if(above(y,0),y+.1*abs(y*sin(1.1*t)), y),y);",
          "",
          "",
          "my_x=.8-x;",
          "my_y=.9-y;",
          "my_z=1.8*z;",
          "",
          "",
          "//// rotations",
          "",
          "d = 70;",
          "zoom = 10;",
          "",
          "w1 = 0;",
          "w2 = 1-.2*sin(.7*t);",
          "w3 = 0;",
          "",
          "x1 = cos(w1)*my_x + sin(w1)*my_y;",
          "y1 = -sin(w1)*my_x + cos(w1)*my_y;",
          "z1 = my_z;",
          "",
          "x2 = cos(w2)*x1 + sin(w2)*z1;",
          "z2 = -sin(w2)*x1 + cos(w2)*z1;",
          "y2 = y1;",
          "",
          "y3 = cos(w3)*y2 + sin(w3)*z2;",
          "z3 = -sin(w3)*y2 + cos(w3)*z2;",
          "x3 = x2;",
          "",
          "l = sqrt(x3*x3 + y3*y3);",
