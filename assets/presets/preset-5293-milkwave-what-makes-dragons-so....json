  "_shaderData": {
    "warp": "",
    "comp": "",
    "perFrameCode": [
      "warp=0;",
      "le=1+.5+2*sin(bass_att);",
      "bpulse=band(above(le,bth),above(le-bth,bblock));",
      "bblock=le-bth;",
      "bth=if(above(le,bth),le+114/(le+10)-7.407,",
      "bth+bth*.07/(bth-12)+below(bth,2.7)*.1*(2.7-bth));",
      "bth=if(above(bth,6),6,bth);",
      "bres=bpulse*sin(pulse+le*.5) + bnot(bpulse)*bres;",
      "",
      "le=1+.5+2*sin(treb_att);",
      "tpulse=band(above(le,tth),above(le-tth,tblock));",
      "tblock=le-tth;",
      "tth=if(above(le,tth),le+114/(le+10)-7.407,",
      "tth+tth*.07/(tth-12)+below(tth,2.7)*.1*(2.7-tth));",
      "tth=if(above(tth,6),6,tth);",
      "tres=tpulse*sin(pulse+le*.5) + bnot(tpulse)*tres;",
      "",
      "le=1+.5+2*sin(mid_att);",
      "mpulse=band(above(le,mth),above(le-mth,mblock));",
      "mblock=le-mth;",
      "mth=if(above(le,mth),le+114/(le+10)-7.407,",
      "mth+mth*.07/(mth-12)+below(mth,2.7)*.1*(2.7-mth));",
      "mth=if(above(mth,6),6,mth);",
      "mres=mpulse*sin(pulse+le*.5) + bnot(mpulse)*mres;",
      "",
      "",
      "",
      "pulse=if(above(abs(pulse),3.14),-3.14,pulse+(bth+mth+tth)*.003);",
      "q1=bres;",
      "q2=tres;",
      "q3=mres;",
      "q4=sin(pulse);",
      "",
      "mod_state=(above(q1,0)+above(q2,0)+above(q3,0))*(1+above(q4,0));",
      "ccl=ccl+tpulse+mpulse-bpulse;",
      "q5=cos(pulse*(.5+.1*mod_state));",
      "q6=sin(pulse*(.5+pow(.25,mod_state)));",
      "q7=mod_state;",
      "q8=ccl;",
      "ob_r=.5+.5*cos(q1+q7);",
      "ob_g=.5+.5*cos(q2*3.14+q7);",
      "ob_b=.5+.5*cos(q3+q8);",
      "ib_size=.025+.02*q2;",
      "ob_size=.03+.02*q3-.002*q7;",
      "wave_r=.5+.5*sin(q1*q7+time*2.183);",
      "wave_g=.5+.5*sin(q2*3+time*1.211);",
      "wave_b=.5+.5*sin(q3+time*1.541);",
      "wave_mystery=wave_mystery+sin(time*2.18+q6);",
      "wave_x=wave_x+.25*sin(time*.811+q1)+.1*(frame%3)*sign(q3);",
      "wave_y=wave_y+.25*sin(time*.788+q2)+.1*(frame%2)*sign(q3);",
      "wave_mode=q7;",
      "cy=q4*2;"
    ],
    "perFrameInitCode": [],
    "perPixelCode": [
      "grid=pow(sin(rad*6*sin(q8)+x*y*16*q1)*2,1+q8%5);",
      "snee=.05*sin(q8)*q7;",
      "snee=above(x,.5+snee)*if(below(q7,3),above(y,.5-snee),below(y,.5+snee))*below(rad,.8+.2*q3);",
      "snur=if(bnot(q7),rad*snee,if(bnot(q8%q7),x,y*bnot(snee)));",
      "rot=snee*bnot(grid%(q8%10+1))*(.8+.2*q5)*sign(q6);",
      "sx=sx-bnot(rot)*.003*sign(sin(q8))*(1+q7*equal(q8%3,0)*sin(x*3.14*q5))*above(x,.7+snee);",
      "sy=sy-bnot(rot)*.003*sign(sin(q7))*(1+q7*equal(q8%2,0)*sin(y*3.14*q4))*above(y,.7+snee);",
      "zoom=if(bnot(q8%4),zoom+.06*sin(snur*6.28*q1),1);",
      "rot=if(below(x,.5+.08*q7)*above(y,.5-.08*q7)*below(rad,1-.2*q7),if(bnot(q8%3),.2*sign(q5),",
      ".03*sin(rad*10*q4)*below(snur,.5)),rot);"
