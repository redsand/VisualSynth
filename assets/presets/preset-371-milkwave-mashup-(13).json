      "",
      "d1 = sqrt((x1-x)*(x1-x)+(y1-y)*(y1-y))-b1*2;",
      "si1 = 1- 1/(1+pow(2,-d1*100));",
      "",
      "d2 = sqrt((x2-x)*(x2-x)+(y2-y)*(y2-y))-b1*2;",
      "si2 = 1- 1/(1+pow(2,-d2*100));",
      "",
      "si3 = -pow(q5,3)*00;",
      "",
      "dx = (si1*sin(y1-y)*m1*d1  - si2*sin(y2-y)*m1*d2 + si3*cos(dir)*t1)*2;",
      "dy = (-si1*sin(x1-x)*m1*d1 + si2*sin(x2-x)*m1*d2 - si3*sin(dir)*t1)*2;"
    ],
