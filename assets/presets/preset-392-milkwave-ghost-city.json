  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  sampler sampler_pw_noise_lq;\nvec3 color, mus, neu, ret1, noise, noise2;\nvec2 uv1, rs0, rs, uv2, uv3, dz, hor, ver;\nfloat dx,dy,speed;\nspeed = .3;\nuv1 = uv-vec2(0.5,q5);\nfloat z = 1/(uv1.y);\nrs0.x = (uv1.x)*z;\nrs0.y = z;\nrs.x = rs0.x *1;\nrs.y = rs0.y + uTime*speed;\n\n\n//Kacheln\nnoise = lum(texture(sampler_pw_noise_lq,rs/63 ));\nnoise *= lum(texture(sampler_pw_noise_lq,rs/12 ))+.5;\nnoise *= clamp01(10*noise - 8) * clamp01(2/z);\nnoise2 = clamp01(8* (lum(texture(sampler_pw_noise_lq,uv))-.5));\n\nspeed *= 2;\nvec3 copy = + GetPixel(vec2(uv.x,uv.y-.04*speed/z));\ncopy +=GetPixel(vec2(uv.x,uv.y-.02*speed/z));\ncopy +=GetPixel(vec2(uv.x,uv.y-.01*speed/z));\n\nret = noise*1 + copy/3*(1+slow_roam_cos)/2*.99-.005;\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  sampler sampler_pw_noise_lq;\nvec3 ret1, neu, cont;\nvec2 rs,rs2,uv1,dz, uv3;\nfloat noise;\nvec2 uv2;\nuv -= 0.5;\nuv *= uAspect.xy;\n\nnoise = texture(sampler_pw_noise_lq,uv3);\nnoise *= (noise >= .9);\n\nfloat dist = 1;\nfloat inten = 1;\nfloat mask = 0;\nret1 = 0;\nint anz = 2;\nfloat n = 0;\ncont = 0;\nwhile (n <= anz) {\nuv2 = uv;\n    dist = 1-fract(1.0/anz*n+q6); //evtl sqrt !\n\n    inten =  (dist)*(1-dist)*6;\n    vec2 uv3 =  fract(1*uv2*dist+.55);\n\n    neu = 1*GetPixel(uv3) + GetBlur1(uv3)*0;\n    ret1 = max(ret1,neu*inten);\n    cont = max(cont,(-GetPixel(uv3)+GetBlur1(uv3+q7))*inten);\nn++;\n}\n\nrs2 = .1*cos(uv*3+vec2(uTime/12,5)) + .1*ret1;\nvec3 dots = clamp01(.005/length(rs2)) * vec3 (1,.9,.6);\n\nret = -.1*ret1 + 18*dots*(.2+.3*ret1)\n+ lum(cont)*(1+slow_roam_cos)/2;\nret += .0*ret1;\n//ret = GetPixel(uv_orig+.5);\n  fragColor = ret;\n}",
    "perFrameCode": [
      "dec_med = pow (0.9, 30/fps);",
      "dec_slow = pow (0.99, 30/fps);",
      "beat = max (max (bass, mid), treb);",
      "avg = avg*dec_slow + beat*(1-dec_slow);",
      "is_beat = above(beat, .2+avg+peak) * above (time, t0+.2);",
      "t0 = is_beat*time + (1-is_beat)*t0;",
      "peak = is_beat * beat + (1-is_beat)*peak*dec_med;",
      "index = (index + is_beat) %8;",
      "",
      "q20 = avg;",
      "q21 = beat;",
      "q22 = peak;",
      "q23 = index;",
      "q24 = is_beat;",
      "q26 = bass + mid + treb;",
      "",
      "k1 =  is_beat*equal(index,0);",
      "p1 =  k1*(p1+1) + (1-k1)*p1;",
      "p2 = dec_slow * p2+ (1-dec_slow)*p1;",
      "rott = p2 * 3.1416/4;",
      "q27 = index + 1;",
      "",
      "q1 = cos(rott);",
      "q2 = sin(rott);",
      "q3 = -q2;",
      "q4 = q1;",
      "",
      "zoom = 1.0;",
      "rot = -0.00 * index;",
      "",
      "q32 = pow(0.996, 30/fps); //fade",
      "q5 = (sin(time/11)+1)/5;",
      "",
      "movez = movez + .06/fps*(1.1+q1);",
      "q6 = movez;",
      "",
      "q7 = .005*sin(time/15);"
    ],
