          "fdX=2*cos(t)*(1+3.1415*cos(2.98+2*t))*cos(.43+2*t+3.1415*sin(2.98+2*t))-sin(t)*sin(.43+2*t+3.1415*sin(2.98+2*t));",
          "fdY=cos(1.9+.7*t)*cos(t)-.7*sin(1.9+.7*t)*sin(t);",
          "fdZ=cos(1.54+2*t)*cos(2*t+3.1415*cos(1.01+2*t))*(2-6.2831*sin(1.01+2*t))-2*sin(1.54+2*t)*sin(2*t+3.1415*cos(1.01+2*t));",
          "invFDmag=1/sqrt( fdX*fdX + fdY*fdY + fdZ*fdZ );",
          "",
          "sdX=-4*cos(.43+2*t+3.1415*sin(2.98+2*t))*(sin(t)+3.1415*sin(2.98+3*t))-cos(t)*(5+25.132*cos(2.98+2*t)+39.4761*sqr(cos(2.98+2*t)))*sin( .43+2*t+3.1415*sin(2.98+2*t));",
