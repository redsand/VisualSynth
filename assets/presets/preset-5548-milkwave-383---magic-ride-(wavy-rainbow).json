          "fdY=fdY*invFDmag;",
          "fdZ=fdZ*invFDmag;",
          "",
          "fnX=snY*fdZ-fdY*snZ;",
          "fnY=snZ*fdX-snX*fdZ;",
          "fnZ=snX*fdY-snY*fdX;",
          "",
          "// Now that I've calculated the vectors, I'll use the first and second normal to 'extrude' the path along an increasing angle on their plane. Since the plane of the first and second normal is always tangent to the curve, this creates the spiral tunnel along the path.",
          "",
          "// The variable 'angl' as it's name implies controls the angle I was just talking about. It should be increasing with 't' if you want the spiral effect. Since t ranges from 0 to 1, the following value results to 30 full circles.",
          "angl=t*30*6.2831; //188.493;",
          "",
          "// 'c' is an overall coefficient for tweaking the radius of the spiral. I am decreasing it based on the sample position. I also want to give it a 'spectrum' kinda look so i'm multiplying it by actual sample values.",
          "c=sqrt(1-.5*sample)*(1+.5*(value1+value2));",
          "",
          "// If (m) is the vector to point on the path, the equations below are no more than the vector equation: (m)=(m)+t3*c*( (sn)*cos(angl) + (fn)*sin(angl) ). This creates the spiral.",
          "mx=mx+t3*c*(snX*cos(angl)+fnX*sin(angl));",
          "my=my+t3*c*(snY*cos(angl)+fnY*sin(angl));",
          "mz=mz+t3*c*(snZ*cos(angl)+fnZ*sin(angl));",
          "",
          "// Now I'm applying the camera to the final coordinates of that point. The 'q' and 't6,7,8' variables were set in the per frame code. I also have to calculate the z-component of the camera's X-axis (qq9) since I thought I was out of variables",
          "qq9=q4*q2-q5*q1;",
          "vx=(q7*mx+q8*my+qq9*mz-(t6*q7+t7*q8+t8*qq9));",
          "vy=(q4*mx+q5*my+q6*mz-(t6*q4+t7*q5+t8*q6));",
          "vw=q1*mx+q2*my+q3*mz-(t6*q1+t7*q2+t8*q3);",
          "",
          "// I'm applying perspective and a scale factor of .15 to the transformed coordinates",
          "ox=(vx/vw)*.15;",
          "oy=(vy/vw)*.15;",
          "",
          "// The bad thing about the projection i used is that now the path looks like all its corners are right. Since I can't change that, I'm applying an extra 90 degress camera roll to (at least) make them look like vertical loops, which is less boring!!! I also scale the monitor's y-axis by 1.25 to compensate for the distortion caused by non-square resolution and pixels.",
          "x=.5-oy;",
          "y=.5+ox*1.25;",
          "",
          "// I'm using the W- component of the vertex to determine if the vertex is visible and (if visible) an alpha value based on it.",
          "a=above(vw,.02)*pow(.6667*(1-min(vw,1)),2);",
          "",
          "// hue2rgb algorithm. In this preset I used the angle of the point in the spiral from its axis.",
          "// The '4' below means colours are repeat 4 times per circle",
          "hue=4*(angl+3*time)/6.2831;",
          "h=6*(hue-int(hue));",
          "sw1=below(h,1); sw2=(1-sw1)*below(h,2); sw3=(1-sw1)*(1-sw2)*below(h,3); sw4=(1-sw1)*(1-sw2)*(1-sw3)*below(h,4);",
          "sw6=above(h,5); sw5=(1-sw1)*(1-sw2)*(1-sw3)*(1-sw4)*(1-sw6);",
          "r=sw1+sw2*(2-h)+sw5*(h-4)+sw6;",
          "g=sw1*h+sw2+sw3+sw4*(4-h);",
          "b=sw3*(h-2)+sw4+sw5+sw6*(6-h);"
        ]
