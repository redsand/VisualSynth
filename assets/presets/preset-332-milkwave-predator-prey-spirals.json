  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  uv =  mix(uv_orig,uv,2) ;\n    vec2 d = uTexSize.zw * 2;\n    vec3 dx = ( GetBlur1(uv + vec2(1,0)*d) - GetBlur1(uv-vec2(1,0)*d) );\n    vec3 dy = ( GetBlur1(uv + vec2(0,1)*d) - GetBlur1(uv-vec2(0,1)*d) );\n\n    vec2 dither_uv = uv_orig*uTexSize.xy*texsize_noise_lq.zw * 1.2 + rand_frame.xy;\n\n    vec2 uv_x= uv + vec2(dx.x,dy.x)*uTexSize.zw  *8;\n    vec2 uv_y= uv + vec2(dx.y,dy.y)*uTexSize.zw  *8;\n    vec2 uv_z= uv + vec2(dx.z,dy.z)*uTexSize.zw  *8;\n    ret.x = GetPixel(uv_x).x - (GetPixel(uv_x) - GetBlur3(uv_x)).x  * 0.02;\n    ret.y = GetPixel(uv_y).y - (GetPixel(uv_y) - GetBlur3(uv_y)).y  * 0.02;\n    ret.z = GetPixel(uv_z).z - (GetPixel(uv_z) - GetBlur3(uv_z)).z  * 0.02;\n\n    ret +=(texture(sampler_noise_lq, dither_uv).xyz-0.5) *0.04;\nret -= ret.yzx*0.1 - 0.02;\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  vec2 uv_x, uv_y, uv_z, uv_echo;\nvec2 d = uTexSize.zw*8;\n    vec3 dx = ( GetBlur1(uv + vec2(1,0)*d) - GetBlur1(uv-vec2(1,0)*d) );\n    vec3 dy = ( GetBlur1(uv + vec2(0,1)*d) - GetBlur1(uv-vec2(0,1)*d) );\n\n\n    vec3 emboss = (dx - dy)*0.5 + 1;\n\n    vec2 uv_light1 = vec2(q4,1-q8);\n    float c = 2;\n    float dd = 1.1;\n    float light1_dy = dd-pow(length( uv - vec2(dx.y,dy.y)*c - uv_light1),.2);\n    float light1_dx = dd-pow(length( uv - vec2(dx.x,dy.x)*c - uv_light1),.2);\n    float light1_dz = dd-pow(length( uv - vec2(dx.z,dy.z)*c - uv_light1),.2);\n\n\n\nret = pow(vec3(light1_dx,light1_dy,light1_dz),1)*GetPixel(uv)*2.4;\n  fragColor = ret;\n}",
    "perFrameCode": [
      "xx1 = xx1*0.9 + (bass)*0.01;",
      "xx2 = xx2*0.9 + (treb)*0.01;",
      "yy1 = yy1*0.94 + (treb+bass)*0.0075;",
      "",
      "x1 = 0.5 + (xx1-xx2)*2;",
      "y1 = 0.4 + yy1;",
      "",
      "x1 = max(0,min(1,x1)); y1 = max(0,min(1,y1));",
      "",
      "spring = 10;",
      "grav = .5;",
      "resist = 1;",
      "bounce = 0.75;",
      "dt = 0.0001*(60/fps);",
      "",
      "vx2 = vx2*(1-resist*dt) + dt*((x1+x3-2*x2)*spring);",
      "vy2 = vy2*(1-resist*dt) + dt*((y1+y3-2*y2)*spring-grav);",
      "vx3 = vx3*(1-resist*dt) + dt*((x2+x4-2*x3)*spring);",
      "vy3 = vy3*(1-resist*dt) + dt*((y2+y4-2*y3)*spring-grav);",
      "vx4 = vx4*(1-resist*dt) + dt*((x3-x4)*spring);",
      "vy4 = vy4*(1-resist*dt) + dt*((y3-y4)*spring-grav);",
      "",
      "x2 = x2 + vx2;",
      "y2 = y2 + vy2;",
      "x3 = x3 + vx3;",
      "y3 = y3 + vy3;",
      "x4 = x4 + vx4;",
      "y4 = y4 + vy4;",
      "",
      "vx2 = if(above(x2,0),vx2,abs(vx2)*bounce);",
      "vx2 = if(below(x2,1),vx2,-abs(vx2)*bounce);",
      "vx3 = if(above(x3,0),vx3,abs(vx3)*bounce);",
      "vx3 = if(below(x3,1),vx3,-abs(vx3)*bounce);",
      "vx4 = if(above(x4,0),vx4,abs(vx4)*bounce);",
      "vx4 = if(below(x4,1),vx4,-abs(vx4)*bounce);",
      "vy2 = if(above(y2,0),vy2,abs(vy2)*bounce);",
      "vy2 = if(below(y2,1),vy2,-abs(vy2)*bounce);",
      "vy3 = if(above(y3,0),vy3,abs(vy3)*bounce);",
      "vy3 = if(below(y3,1),vy3,-abs(vy3)*bounce);",
      "vy4 = if(above(y4,0),vy4,abs(vy4)*bounce);",
      "vy4 = if(below(y4,1),vy4,-abs(vy4)*bounce);",
      "q4 = x4;",
      "q8 = y4;",
      "",
      "q1 = aspectx;",
      "q2 = aspecty;",
      "q10 = x1;",
      "q11 = y1;",
      "zoom = 1;",
      "warp = 0;",
      "q6 = atan2(vx4,vy4);",
      "q5 = sqrt(vx4*vx4 + vy4*vy4);",
      "",
      "a = a*0.95 + q5;",
      "",
      "s = s*0.9 + a;",
      "q3 = s*0.1;",
      "monitor = s;",
      "",
      "wave_a = 0;"
    ],
    "perFrameInitCode": [
      "x1 = 0.9;",
      "y1 = 0.5;",
      "",
      "x2 = 0.5; y2 = 0.5;",
      "x3 = 0.5; y3 = 0.5;",
      "x4 = 0.5; y4 = 0.5;"
    ],
    "perPixelCode": [
      "x = 0.5 + (x-0.5)*q1;",
      "y = 0.5 + (y-0.5)*q2;",
      "xx = q4;",
      "yy = 1-q8;",
      "",
      "dx = 0; dy = 0;",
      "",
      "d = sqrt((x-xx)*(x-xx)+(y-yy)*(y-yy));",
      "",
      "r = 0.1;",
      "v = 20;",
      "v2 = q5;",
      "dx = (v*(sin(y-yy)*(d-r)-(x-xx)*(d-r/2)) + cos(dir)*v2)*(1.00-sigmoid(d-r,120));",
      "dy = (-v*(sin(x-xx)*(d-r)+(y-yy)*(d-r/2)) -sin(dir)*v2)*(1.00-sigmoid(d-r,120));"
    ],
