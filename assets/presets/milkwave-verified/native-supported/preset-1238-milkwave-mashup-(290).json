      "num = 8;",
      "pi = 3.141592654;",
      "radi = (y-.5)*.75;",
      "radi = (y-.5);",
      "radi = pow(radi*radi + (x-.5)*(x-.5),.5);",
      "",
      "an = ang + pi + time;",
      "an = an - pi*2*int(an/(pi*2));",
      "",
      "mod = .1;",
      "",
      "seg = ang + pi;",
      "seg = seg/(pi*2)*num;",
      "seg = int(seg);",
      "seg = seg - equal(seg,num);",
      "",
      "anga = (ang + pi) - (pi*2/num)*seg;",
      "anga = if(equal(seg%2,0),(pi*2/num) - anga,anga);",
      "//anga = anga + pi/6; // num = 6",
      "anga = anga + pi/4; // num = 8",
      "//anga = anga + .85; // num = 10",
      "",
      "",
      "ox = .5 - radi*sin(anga);",
      "oy = .5 + radi*cos(anga);",
      "",
      "//rot = if(equal(seg,0),rot,0);",
      "",
      "dx = equal(seg,3)*(x-ox);",
      "dy = equal(seg,3)*(y-oy);",
      "",
      "dx = above(seg,0)*(x-ox);",
      "dy = above(seg,0)*(y-oy);",
      "",
