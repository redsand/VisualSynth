        "perPointCode": [
          null,
          "division = int(sample*4) + 1;",
          "",
          "",
          "wave=(value1*170 + value2*170) * 0.5;",
          "",
          "//// first frequency band, full frame 60hz@60fps",
          "//set to 0 at beginning of frame",
          "band1max = if( equal(sample,0) , -1, band1max);",
          "band1min = if( equal(sample,0) , 1 , band1min);",
          "",
          "//accumulate values",
          "band1max = max(wave,band1max);",
          "band1min = min(wave,band1min);",
          "",
          "//center max and min around 0 and return max value [range 0-1]",
          "band1 = if( equal(sample,1) , band1max - ((band1min+band1max)*0.5) , band1 );",
          "t1 = band1;",
          "",
          "//// 3rd frequency band",
          "//divide wave form over frame into subsections",
          "segmentlength = 8;",
          "section = (sample*segmentlength) - int(sample*segmentlength - 0.0001);",
          "zerotest= (1/(512/segmentlength));",
          "onetest =1 - zerotest;",
          "",
          "//set to 0 at beginning of frame",
          "band3max = if( below(section,zerotest) , -1 , band3max);",
          "band3min = if( below(section,zerotest) , 1 , band3min);",
          "maxhold3 = if( below(sample ,1/512) , 0 , maxhold3 );",
          "",
          "//accumulate values",
          "band3max = max(wave,band3max);",
          "band3min = min(wave,band3min);",
          "",
          "//center max and min around 0 and return max value [range 0-1]",
          "band3temp = if( above(section,onetest), band3max - ((band3min+band3max)*0.5) , band3temp );",
          "",
          "maxhold3 = if( above(section,onetest) , maxhold3 + band3temp , maxhold3 );",
          "band3 = if( equal(sample,1) , maxhold3/segmentlength , band3 );",
          "",
          "//t3 = (band3 - (1/segmentlength)) / (1 - 1/segmentlength);",
          "t3 = band3;",
          "",
          "//// 5th frequency band",
          "//divide wave form over frame into subsections",
          "segmentlength = 32;",
          "section = (sample*segmentlength) - int(sample*segmentlength - 0.00001);",
          "zerotest= (1/(512/segmentlength));",
          "onetest =1 - zerotest;",
          "",
          "//set to 0 at beginning of frame",
          "band5max = if( below(section,zerotest) , -1, band5max);",
          "band5min = if( below(section,zerotest) , 1 , band5min);",
          "maxhold5 = if( below(sample ,1/512) , 0 , maxhold5 );",
          "",
          "//accumulate values",
          "band5max = max(wave,band5max);",
          "band5min = min(wave,band5min);",
          "",
          "//center max and min around 0 and return max value [range 0-1]",
          "band5temp = if( above(section,onetest) , band5max - ((band5min+band5max)*0.5) , band5temp );",
          "",
          "maxhold5 = if( above(section,onetest) , maxhold5 + band5temp , maxhold5 );",
          "band5 = if( equal(sample,1) , maxhold5/segmentlength , band5 );",
          "",
          "//t5 = (band5 - (1/segmentlength)) / (1 - 1/segmentlength);",
          "t5 = band5;",
          "",
          "//// 7th frequency band",
          "//divide wave form over frame into subsections",
          "segmentlength = 128;",
          "section = (sample*segmentlength) - int(sample*segmentlength - 0.00001);",
          "zerotest= (1/(512/segmentlength));",
          "onetest =1 - zerotest;",
          "",
          "//set to 0 at beginning of frame",
          "band7max = if( below(section,zerotest) , -1 , band7max);",
          "band7min = if( below(section,zerotest) , 1 , band7min);",
          "maxhold7 = if( below(sample ,1/512) , 0 , maxhold7 );",
          "",
          "//accumulate values",
          "band7max = max(wave,band7max);",
          "band7min = min(wave,band7min);",
          "",
          "//center max and min around 0 and return max value [range 0-1]",
          "band7temp = if( above(section,onetest) , band7max - ((band7min+band7max)*0.5) , band7temp );",
          "",
          "maxhold7 = if( above(section,onetest) , maxhold7 + band7temp , maxhold7 );",
          "band7 = if( equal(sample,1) , maxhold7/segmentlength , band7 );",
          "",
          "//t7 = (band7 - (1/segmentlength)) / (1 - 1/segmentlength);",
          "t7 = band7;",
          "",
          "t1=t1*1.9;",
          "t2=t2*2.8;",
          "t3=t3*3.5;",
          "t4=t4*5;",
          "t5=t5*7;",
          "t6=t6*12;",
          "t7=t7*16;",
          "t8=t8*29;",
          "t1=pow(t1,2);",
          "t2=pow(t2,2);",
          "t3=pow(t3,2);",
          "t4=pow(t4,2);",
          "t5=pow(t5,2);",
          "t6=pow(t6,2);",
          "t7=pow(t7,2);",
          "t8=pow(t8,2);",
          "",
          "",
          "t1=max(t1-t3 , 0);",
          "t3=max(t3-t5 , 0);",
          "t5=max(t5-t7 , 0);",
          "",
          "q1=t1;q2=t2;q3=t3;q4=t4;q5=t5;q6=t6;q7=t7;q8=t8;",
          "",
          "n=sample*6.283 + time*0.3;",
          "x=sin(n) * 0.05 + 0.5 + ( (int(rand(1000))-500)*0.00001 );",
          "y=cos(n) * 0.05 + 0.5 + ( (int(rand(1000))-500)*0.00001 );",
          "",
          "",
          "t3= pow(t3,0.5);",
          "t5= pow(t5,0.5);",
          "t7= pow(t7,0.5);",
          "",
          "r1=if( equal(division,1) , t1 , r1 );",
          "r1=if( equal(division,2) , t3 , r1 );",
          "r1=if( equal(division,3) , t5 , r1 );",
          "r1=if( equal(division,4) , t7 , r1 );",
          "",
          "r1=min(r1,1);",
          "r1=max(r1,0);",
          "r=sin(sample*3.14 + time + 0.0)*0.5+0.5;",
          "",
          "g=sin(sample*3.14 + time + 2.1)*0.5+0.5;",
          "",
          "b=sin(sample*3.14 + time + 4.2)*0.5+0.5;",
          "",
          "a= ( sin(sample*6.283*4 + 4.74)*0.5+0.5  );",
          "a=max(a - (1-r1) , 0) / r1;",
          "a=pow( a*r1 , 1-r1*0.5);",
          "",
          "r=min( r * (1+r1) , 1);",
          "g=min( g * (1+r1) , 1);",
          "b=min( b * (1+r1) , 1);",
          "",
          ""
        ]
