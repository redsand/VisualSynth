          "toll = toll*(1-equal(ita,50));",
          "",
          "",
          "la = if((1-t3)*equal(ita,50)*equal(seg,1),tav,la);",
          "lb = if((1-t3)*equal(ita,50)*equal(seg,2),tav,lb);",
