  "_shaderData": {
    "warp": "",
    "comp": "",
    "perFrameCode": [
      "// Dance of the electron",
      "// 2003.01.25 - raron",
      "",
      "",
      "// positions",
      "q1 = 0.4 + 0.3*cos(time + bass_att);",
      "q2 = 0.4 + 0.3*sin(time* 2.5 + bass_att);;",
      "q3 = 0.6 + 0.3*cos(time * 1.5 + treb_att);",
      "q4 = 0.6 + 0.3*sin(time* 3 + treb_att);;",
      "",
      "// charges",
      "q5 = 1 - bass_att;",
      "q6 = 0.5;",
      "",
      "q8 = meshx / meshy;"
    ],
    "perFrameInitCode": [],
    "perPixelCode": [],
    "waves": [
      {
        "enabled": true,
        "samples": 512,
        "sep": 0,
        "bSpectrum": false,
        "bUseDots": false,
        "bDrawThick": false,
        "bAdditive": false,
        "scaling": 1,
        "smoothing": 0.5,
        "r": 1,
        "g": 1,
        "b": 1,
        "a": 1,
        "initCode": [],
        "perFrameCode": [
          null,
          "// Nr. of fieldlines (\"spokes\") from a particle",
          "lines = 32;",
          "",
          "// particle radius",
          "t5 = 0.01;",
          "",
          "// fieldline step length",
          "// t6 = 0.02;",
          "t6 = 0.01 + 0.015 * bass_att;",
          "",
          "// stuff",
          "t1 = int(512 / lines);",
          "t2 = 1 / t1;",
          "t3 = lines;",
          "t4 = 1 / t3;",
          "",
          "// symmetrical facing",
          "dist_y = (q4-q2)/q8;",
          "dist = sqrt(sqr(q3-q1)+sqr(dist_y));",
          "t7 = acos((q3-q1)/dist);",
          "t7 = if(below(dist_y,0),0-t7,t7);",
          "t7 = t4 * 3.1415 + t7;",
          ""
        ],
        "perPointCode": [
          null,
          "// particle data",
          "c1 = q5;",
          "c2 = q6;",
          "// c3 = 1;",
          "Qx = q1;",
          "Qy = q2;",
          "Qrad = t5;",
          "",
          "pi = 3.1415;",
          "lineseg = (sample*511) % t1;",
          "line = int(sample*511*t2);",
          "",
          "//don't draw back-to-next-line-line",
          "a = if(equal(lineseg,0),0,1);",
          "a = if(equal(lineseg,t1-1),0,a);",
          "",
          "scanangle = line * t4 * 2 * pi + t7;",
          "",
          "start_x = Qrad * cos(scanangle);",
          "start_y = Qrad * sin(scanangle) * q8;",
          "",
          "seg_x = if(equal(lineseg,0),start_x,seg_x);",
          "seg_y = if(equal(lineseg,0),start_y,seg_y);",
          "",
          "",
          "// E-fieldstrength stuff",
          "E = 0;",
          "Ex = 0;",
          "Ey = 0;",
          "",
          "// from itself",
          "dist = sqrt(sqr(seg_x)+sqr(seg_y));",
          "E = c1 / dist;",
          "Ex = E * seg_x / dist;",
          "Ey = E * seg_y / dist;",
          "",
          "// from particle 2",
          "dist_x = (Qx+seg_x)-q3;",
          "dist_y = (Qy+seg_y)-q4;",
          "dist = sqrt(sqr(dist_x)+sqr(dist_y));",
          "E = c2 / dist;",
          "Ex = Ex + E * dist_x / dist;",
          "Ey = Ey + E * dist_y / dist;",
          "",
          "//don't draw lines inside other particle",
          "a = if(below(dist,t6),0,a);",
          "",
          "// Figure out E-field and linesegment direction",
          "angle = atan(Ey/Ex);",
          "angle = if(below(Ex,0),angle + pi,angle);",
          "angle = if(above(Ex,0),if(below(Ey,0),angle + 2 * pi,angle),angle);",
          "angle = if(equal(Ex,0),if(above(Ey,0),pi * 0.5,angle),angle);",
          "angle = if(equal(Ex,0),if(below(Ey,0),pi * 1.5,angle),angle);",
          "// Turn 180 degrees if negative self charge",
          "angle = if(below(c1,0),angle+pi,angle);",
          "",
          "",
          "seg_x = seg_x + t6 * cos(angle);",
          "seg_y = seg_y + t6 * sin(angle);",
          "",
          "seg_x = if(equal(lineseg,0),start_x,seg_x);",
          "seg_y = if(equal(lineseg,0),start_y,seg_y);",
          "",
          "",
          "x = Qx + seg_x;",
          "y = Qy + seg_y;",
          ""
        ]
      },
