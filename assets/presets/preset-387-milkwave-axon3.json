  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  sampler sampler_worms;\nvec3 color, mus;\nfloat dx,dy;\nfloat corr = uTexSize.xy*texsize_noise_lq.zw;\n\nvec2 uv1 = (uv-.5);\n\nfloat f1 = 2;\n\nvec2 uv6 = uv1;\n\n\n//LIESMICH - diese Formel gibt nur eine Spinne:\nfloat rota = lum(texture(sampler_noise_hq,uv1.x/4))*.91;\n\n//LIESMICH - diese Formel gibt auch geschlossene Ringe:\nrota = lum(texture(sampler_noise_hq,uv1/2+uTime/20))*3;\n\n\nuv6 = multiply(uv1,mat2(cos(rota),-sin(rota),sin(rota),cos(rota)));\n\n\nmus = .01/(sqrt(uv6.y)+.2);\n\nvec3 blur = GetBlur1(fract(uv));\n\nvec2 hor = vec2 (0.005,0);\nvec2 ver = vec2 (0,.005);\n\nfloat dx = lum(texture(sampler_main,uv+hor)\n         - texture(sampler_main,uv-hor));\nfloat dy = lum(texture(sampler_main,uv+ver)\n         - texture(sampler_main,uv-ver));\n\nvec2 zz = vec2 (dx,dy);\n\n\nvec3 crisp= texture(sampler_main,uv+zz*.04);\ncrisp +=.015 - length(zz)*blur/2;\n\nvec3 ret1 = crisp - blur*.02 + abs(mus);\nret = ret1 * .99 -  .04 ;\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  vec3 ret1, neu;\nvec2 rs,rs2,uv1;\nvec2 uv2;\nfloat ang2, c, s;\nuv -= 0.5;\nuv *= uAspect.xy;\n\nfloat dist = 1;\nfloat inten = 1;\nfloat mask = 0;\nret1 = 0;\nint anz = 3;\nfloat n = 0;\nwhile (n <= anz) {\n    ang2 = 6.28*n/anz;\n    c = cos(ang2);\n    s = sin(ang2);\n    uv2.x =  uv.x*c - uv.y*s;\n    uv2.y =  uv.x*s + uv.y*c;\n\n    dist = 1-fract(1.0/anz*n+uTime/2); //evtl sqrt !\n\n    inten =  sqrt(dist)*(1-dist)*8;\nvec2 uv3 =  fract(3*uv2*dist + 0.5+vec2(q1,q2)*.05);\n    neu = 1*GetPixel(uv3) -GetBlur1(uv3+.003);\n    ret1 = max(ret1,neu*inten);\nn++;\n}\n\nrs2 = .5*cos(uv*13) - ret1;;\nfloat dots = clamp01(.05/length(rs2)) ;\n\n\nret = 2*ret1.gbr + 21*dots*(.1+3*ret1) ;\nret = ret1*4;\n  fragColor = ret;\n}",
    "perFrameCode": [
      "dec_med = pow (0.9, 30/fps);",
      "dec_slow = pow (0.99, 30/fps);",
      "beat = max (max (bass, mid), treb);",
      "avg = avg*dec_slow + beat*(1-dec_slow);",
      "is_beat = above(beat, .2+avg+peak) * above (time, t0+.2);",
      "t0 = is_beat*time + (1-is_beat)*t0;",
      "peak = is_beat * beat + (1-is_beat)*peak*dec_med;",
      "index = (index + is_beat) %8;",
      "index2 = (index2 + is_beat*bnot(index))%4;",
      "",
      "q20 = avg;",
      "q21 = beat;",
      "q22 = peak;",
      "q23 = index;",
      "q24 = is_beat;",
      "q26 = bass + mid + treb;",
      "",
      "//k1 =  is_beat*bnot(index)*bnot(index2);",
      "",
      "k1 =  is_beat*equal(index,0);",
      "p1 =  k1*(p1+1) + (1-k1)*p1;",
      "p2 = dec_med * p2+ (1-dec_med)*p1;",
      "rott = p2 * 3.14159265359/4;",
      "",
      "q27 = 8-index;",
      "q28 = index2;",
      "",
      "q1 = cos(rott);",
      "q2 = sin(rott);",
      "q3 = -q2;",
      "q4 = q1;",
      "",
      "q5 = q1 * bnot(index2);",
      ""
    ],
