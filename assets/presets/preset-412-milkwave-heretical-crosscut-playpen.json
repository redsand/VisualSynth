  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  float corr = uTexSize.xy*texsize_noise_lq.zw;\nvec2 uv1 = vec2(uv.x-0.5,uv.y-0.5)*uAspect.xy;\n\n\nvec3 noiseVal =lum (texture(sampler_noise_lq, corr*uv*.02+ .1*rand_frame));\n\nvec2 k1 = vec2((uv.x), (uv.y));\n\nvec3 ret1 = GetBlur1(uv) ;\n\nfloat k2 = (20*uv)%2;\n\nvec2 zz = uv.xy * uTexSize.xy *.08;\nfloat h1 = (tan(zz.x));\nfloat h2 = (tan(zz.y));\n\nuv.xy -= vec2(h1,h2)*uTexSize.zw * 3;\n\n\nvec3 crisp = texture(sampler_main,uv) + noiseVal/30;\n\ncrisp = mix(crisp, 1-crisp.zyx, 0.01);\n\n ret = crisp -.03 - 0.2*pow(1-rad,18);\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  sampler sampler_seaweed;\nuv = uv + 2*uTexSize.zw*vec2(cos(uv.y*uTexSize.y/2),sin(uv.x*uTexSize.x/2));\n\n    ret = 1.4*pow(clamp01(GetBlur1(uv))*((texture(sampler_pc_main,uv)-GetBlur3(uv))),0.5);\n  fragColor = ret;\n}",
    "perFrameCode": [
      "dec_med = pow (0.96, 30/fps);",
      "dec_slow = pow (0.999, 30/fps);",
      "beat = max (max (bass, mid), treb);",
      "avg = avg*dec_slow + beat*(1-dec_slow);",
      "is_beat = above(beat, .5+avg+peak) * above (time, t0+.2);",
      "t0 = is_beat*time + (1-is_beat)*t0;",
      "peak = is_beat * beat + (1-is_beat)*peak*dec_med;",
      "index = (index + is_beat) %8;",
      "index2 = (index2 + is_beat*bnot(index))%2;",
      "index3 = (index3 + is_beat*bnot(index) * bnot(index2))%2;",
      "",
      "q20 = avg;",
      "q21 = beat;",
      "q22 = peak;",
      "q23 = index;",
      "q24 = is_beat;",
      "",
      "vol = bass_att + treb_att;",
      "v2 = v2 * dec_med + vol * (1-dec_med) ;",
      "q26 = max(atan (vol - v2),0);",
      "q27 = index + 1;",
      "",
      "sw = sw*dec_med + (1-dec_med)*(index2%2);",
      "q28 = sw;",
      "kiss = kiss*dec_med",
      "      +(1-dec_med)*bnot(index2)*below(index,4);",
      "q29 = kiss;",
      "",
      "k1 =  is_beat*bnot(index);",
      "k2 =  is_beat*bnot(index);",
      "p1 =  k1*(p1+1) + (1-k1)*p1;",
      "p2 = dec_med * p2+ (1-dec_med)*p1;",
      "rott = p2 * 3.1416/2;",
      "monitor = k1;",
      "q1 = cos(rott);",
      "q2 = sin(rott);",
      "q3 = -q2;",
      "q4 = q1;",
      "",
      "",
      "q5 = cos(time/4);",
      "q6 = -sin(time/4);",
      "q7 = -q6;",
      "q8 = q5;",
      "",
      "zoom = 1;",
      "rot = -0;",
      "",
      "",
      "//KUGEL-POS",
      "dt = .1*30/fps;",
      "m = 1; //Masse",
      "//Gravitationszentrum",
      "x0 = .0; y0 = 0;",
      "",
      "ax = -(xk-x0)/m + sign(vx+.001)*dt*bass/40;",
      "ay = -(yk-y0)/m + sign(vy+.001)*dt*treb/40;",
      "monitor = index3;",
      "vx = vx*dec_slow + ax * dt;",
      "vy = vy*dec_slow + ay * dt;",
      "",
      "xk = xk + vx*dt;",
      "yk = yk + vy*dt;",
      "",
      "q9 = xk; q10 = yk;",
      "",
      "",
      ""
    ],
    "perFrameInitCode": [
      "vol = 0; p1 = 0;",
      "vx = .2; vy = -0.1;",
      "kx = 0; ky = 0;",
