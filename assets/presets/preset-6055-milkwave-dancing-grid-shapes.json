      "",
      "shapepos = if(above(timepop, 0.24), 8+int(rand(6)), shapepos);",
      "shapegeomtrans = if(above(timepop, 0.24), 3+int(rand(6)), shapegeomtrans);",
      "shaperot = if(above(timepop, 0.24), rand(10), shaperot);",
