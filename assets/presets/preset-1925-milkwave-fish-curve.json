        "initCode": [],
        "perFrameCode": [],
        "perPointCode": [
          null,
          "",
          "///// Fish curve",
          "",
          "a1=1;",
          "t= 100*q20;",
          "",
          "px = a1*cos(t)-a1*sin(t)*sin(t)*.5;",
          "py = .5*a1*cos(.02*t)*sin(2*t);",
          "pz = q20;",
          "",
          "",
          "///////surface",
          "",
          "a1=1;",
          "t= 100*sample;",
          "",
          "sx = a1*cos(t)-a1*sin(t)*sin(t)*.5;",
          "sy = .5*a1*cos(.02*t)*sin(2*t);",
          "sz = sample;",
          "",
          "sx = if(below(sample,.1), sin(31.4*sample-.1)+.1*sin(time+q1),sx);",
          "sx = if(above(sample,.1)*below(sample,.2),-1,sx);",
          "sy = if(below(sample,.1),0,sy);",
          "sz = if(below(sample,.1),.3-25*sz,sz);",
          "",
          "",
          "my_x = sx+ px;",
          "my_y = sy+ py;",
          "my_z = -sz+ pz;",
          "",
          "",
          "/////// rotations",
          "",
          "d = 2;",
          "zoom = 1;",
          "",
          "w1 = 1.57 + atan2(py,px);",
          "w2 = 3.14;",
          "w3 = 1.57;",
          "",
          "x1 = cos(w1)*my_x + sin(w1)*my_y;",
          "y1 = -sin(w1)*my_x + cos(w1)*my_y;",
          "z1 = my_z;",
          "",
          "x2 = cos(w2)*x1 + sin(w2)*z1;",
          "z2 = -sin(w2)*x1 + cos(w2)*z1;",
          "y2 = y1;",
          "",
          "y3 = cos(w3)*y2 + sin(w3)*z2;",
          "z3 =( -sin(w3)*y2 + cos(w3)*z2);",
          "x3 = x2;",
          "",
          "l = sqrt(x3*x3 + y3*y3);",
          "w = atan2(x3,y3);",
          "d = sqrt(x3*x3 + y3*y3 + (z3+d)*(z3+d));",
          "p = tan(asin(1) + atan2(d+z3,l));",
          "",
          "my_x = zoom*sin(w)*p;",
          "my_y = zoom*cos(w)*p;",
          "",
          "x = 0.5 + my_x/q6;",
          "y = 0.3 + my_y/q5;",
          "",
          "x = 0.5 + (x-.5)/q5;",
          "y = 0.5 + (y-.5)/q6;",
          "",
          "////////",
          "",
          "a = if(above(sample,.1),.2*a,a);",
          "",
          "r=.5+.5*sin(21*sample+q2);",
          "g=.5+.5*sin(26*sample+q1);",
          "b=.5+.5*sin(14*sample+q3);"
        ]
      },
