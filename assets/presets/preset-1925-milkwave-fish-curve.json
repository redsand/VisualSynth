    "comp": "",
    "perFrameCode": [
      "warp=0;",
      "wave_a=0;",
      "zoom=1;",
      "decay=.5;",
      "",
      "//// flexi's beat counter",
      "bt1 = bt1*0.95 + sqr(bass*3)*30/fps;",
      "mt1 = mt1*0.95 + sqr(mid*3)*30/fps;",
      "tt1 = tt1*0.95 + sqr(treb*3)*30/fps;",
      "bt2 = bt2 + bt1*0.005;",
      "mt2 = mt2 + mt1*0.005;",
      "tt2 = tt2 + tt1*0.005;",
      "",
      "q1 = .5*time+mt2 *0.01;",
      "q2 = .5*time+bt2 *0.01;",
      "q3 = .5*time+tt2 *0.01;",
      "",
      "q5=aspectx;",
      "q6=aspecty;",
      "",
      "",
      "speed= 7;  ////// tweak",
      "",
      "",
      "t0=t0+1/fps;",
      "q20= abs(sin(.001*speed*t0));",
      "q21= abs(sin(.02*speed*t0));"
    ],
    "perFrameInitCode": [],
    "perPixelCode": [],
    "waves": [
      {
        "enabled": true,
        "samples": 512,
        "sep": 0,
        "bSpectrum": false,
        "bUseDots": false,
        "bDrawThick": true,
        "bAdditive": false,
        "scaling": 0.01,
