  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  float corr = uTexSize.xy*texsize_noise_lq.zw;\nvec2 uv1 = vec2(uv.x-0.5,uv.y-0.5)*uAspect.xy;\n\nvec2 uv6=sin(23*uv);\nfloat dots = .001/length(uv6)*q1*q1;\n\n\nvec2 zz = uv.xy * uTexSize.xy *.04;\nfloat h1 = (cos(zz.y*q1) * sin(-zz.y));\nfloat h2 = (sin(zz.x) * cos(zz.y*q2));\n\nuv.xy -= vec2(h1,h2)*uTexSize.zw * 24*q28;\n\nvec3 crisp = 1*GetPixel(uv) + .0*lum(GetPixel(uv));\nret = crisp*.99 -.006;\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  vec3 ret1, neu, dx, dy, sun, sky;\nvec2 rs,rs2,uv1,uv2, uv3,uv4,uv5,dz;\nvec2 hor = vec2(uTexSize.z,0);\nvec2 ver = vec2(0,uTexSize.w);\n\nuv5 = uv;\nuv1 = uv-0.5;\nuv1 *= uAspect.xy;\ndz = 0;\nfloat dist = 1;\nfloat inten = 1;\nfloat mask = 0;\nret1 = 0;\nint anz = 3;\nfloat n = 0;\nwhile (n <= anz) {\n    dist = 1-fract(1.0/anz*n+q29); //evtl sqrt !;\n    inten =  (dist)*(1-dist*dist)*4;\n\n//dist *= dist ;\n\n    uv3 = 2*uv1*dist + vec2(q30,.5);\nuv3 *= uAspect.yx;\n    neu = GetPixel(uv3);\n    dz.x += inten*lum(GetPixel(uv3+hor)- GetPixel (uv3-hor));\n    dz.y += inten*lum(GetPixel(uv3+ver)- GetPixel (uv3-ver));\n    ret1 = max(ret1,neu*inten);\nn++;\n}\n\n//sun\nuv1 += dz/2;\nuv4 = sin(3*uv1+uTime/18*vec2(1,.9));\nfloat k1 = texture(sampler_noise_lq,uv);\nsun = clamp01(4*(.25-uv1.y)) * .3/length(uv4) ;\nsun *= .5+.5*rand_preset*vec3(1,1,.3);\n\nvec3 sky = vec3 (uv.y,.2,1.5-uv.y);\nsky = sun * (.5+sky);\n\n//tree\nk1 = .5*(rand_preset-.5);\nuv3 = 150 * (uv1-vec2(k1,.05)) + dz;\n\nfloat zu = .3*lum(texture(sampler_noise_lq,uv));\nfloat ky = clamp01(-.01*uv3.y+zu*cos(12*zu));\n\nk1 = uv3.x*(1);;\nk1 = k1 - sign (k1)*16; //Verdoppelung\n\nn = 1 ;\nwhile (n <= 5)\n{\n  k1 += 2*(k1-6*n*sign(k1))*ky;\n  ky = clamp01(ky -.08);\n  n++;\n}\n\nk1 = clamp(k1,-1.6,1.6);\n\nvec3 tree = 2*abs(cos(k1))*pow(uv.y,2);\n\nret = .1+.4*rand_preset.x*ret1 + clamp01(sky - tree);\n//ret = GetPixel(uv5);\n  fragColor = ret;\n}",
    "perFrameCode": [
      "dec_med = pow (0.96, 30/fps);",
      "dec_slow = pow (0.99, 30/fps);",
      "beat = max (max (bass, mid), treb);",
      "avg = avg*dec_slow + beat*(1-dec_slow);",
      "is_beat = above(beat, .4+avg+peak) * above (time, t0+.2);",
      "t0 = is_beat*time + (1-is_beat)*t0;",
      "peak = is_beat * beat + (1-is_beat)*peak*dec_med;",
      "index = (index + is_beat) %8;",
      "index2 = (index2 + is_beat*bnot(index))%4;",
      "index3 = (index3 + is_beat*bnot(index)*bnot(index2))%3;",
      "",
      "",
      "q20 = avg;",
      "q21 = beat;",
      "q22 = peak;",
      "q23 = index;",
      "q24 = is_beat;",
      "q26 = bass + mid + treb;",
      "",
      "//k1 =  is_beat*bnot(index)*bnot(index2);",
      "",
      "k1 =  is_beat*equal(index,0);",
      "p1 =  k1*(p1+1) + (1-k1)*p1;",
      "p2 = dec_med * p2+ (1-dec_med)*p1;",
      "rott = p2 * 3.14159265359/4;",
      "",
      "q27 = 8-index;",
      "q28 = sin(time/7);",
      "q29 = index4;",
      "",
      "q1 = cos(rott);",
      "q2 = sin(rott);",
      "q3 = -q2;",
      "q4 = q1;",
      "",
      "mv_a = .5 * q1;",
      "",
      "movez = movez + .01 * 30/fps ;",
      "q29 = movez;",
      "",
      "movex = movex + .003 * 30/fps *q2;",
      "q30 = movex;",
      "",
      "q31 = sqr(sin(time/17));",
      "q32 = sqr(cos(time/17));",
      "",
      "zoom = 1.0;",
      "rot = .0;",
      "dx = .0;",
      "warp = .2;"
    ],
