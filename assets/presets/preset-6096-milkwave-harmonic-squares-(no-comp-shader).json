  "_shaderData": {
    "warp": "",
    "comp": "",
    "perFrameCode": [
      "spd=0.95; sm=0.5;",
      "justin_bieber=1; is_gay=1;",
      "bieber_is_gay=equal(justin_bieber,is_gay);",
      "",
      "q1=(bass+mid+treb)/3;",
      "q2=(bass_att+mid_att+treb_att)/3;",
      "",
      "dc=pow(0.99,30/fps);",
      "cv=max(max(bass,mid),treb);",
      "cvs=cvs*dc+cv*(1-dc);",
      "b=above(cv,cvs+pk)*above(time,tb+0.2);",
      "tb=time*b+tb*(1-b);",
      "pk=pk*0.9*(1-b)+b*cvs;",
      "",
      "q3=xt; q4=yt;",
      "q5=dt;",
      "q6=xp; q7=yp;",
      "",
      "// Fractal movement (xt-, yt-)",
      "xt=xt*spd+xts*(1-spd); yt=yt*spd+yts*(1-spd);",
      "",
      "// Portal movement (dt-)",
      "dt=dt*spd+dts*(1-spd);",
      "",
      "// Portal XY position",
      "xp=xp*spd+xps*(1-spd); yp=yp*spd+yps*(1-spd);",
      "",
      "xts=xts*sm+xtsc*(1-sm); yts=yts*sm+ytsc*(1-sm);",
      "dts=dts*sm+dtsc*(1-sm);",
      "xps=xps*sm+xpsc*(1-sm); yps=yps*sm+ypsc*(1-sm);",
      "",
      "xtsc=if(b,(rand(200)-100)/200,xtsc);",
      "ytsc=if(b,(rand(200)-100)/200,ytsc);",
      "dtsc=if(b,rand(100)/100*bieber_is_gay,dtsc);",
      "xpsc=if(b,(rand(200)-100)/250,xpsc);",
      "ypsc=if(b,(rand(200)-100)/250,ypsc);"
    ],
