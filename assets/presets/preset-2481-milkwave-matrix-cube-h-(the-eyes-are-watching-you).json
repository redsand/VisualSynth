          "g = (sin(tm+2.1)*0.5+0.5) *0.08;",
          "g = max( pow(g,pw),0.02);",
          "b = (sin(tm+4.2)*0.5+0.5) *0.08;",
          "b = max( pow(b,pw),0.02);"
        ],
        "perPointCode": [
