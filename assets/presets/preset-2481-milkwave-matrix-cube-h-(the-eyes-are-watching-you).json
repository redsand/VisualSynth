          "//rotating sphere",
          "",
          "n = sample*6.283;",
          "",
          "",
          "//draw circle, loop 32x",
          "xp = -1;",
          "xp =   if( equal(t3,1) , 1 , xp );",
          "xp = if( equal(t3,2) , 1 , xp );",
          "xp = xp*2;",
          "yp = t4 * t6;",
          "yp = yp*2;",
          "zp = t5 + t7;",
          "",
          "t4h = t4;",
          "t4h = if( equal(t3,1) , t4h + 0.125 , t4h );",
          "t4h = if( equal(t3,3) , t4h + 0.125 , t4h );",
          "t3 = t3 + 1;",
          "t6h = t6;",
          "t6h = if( equal(t4h,1.125) , -t6h , t6h );",
          "t6 = t6h;",
          "t5 = if( equal(t4h,1.125) , t5 + 0.125 , t5 ) ;",
          "t4h = if( equal(t4h,1.125) , -1 , t4h );",
          "t4 = t4h;",
          "t3 = t3 * (1-equal(t3,4));",
          "",
          "//x axis rotation;",
          "ang = t1;",
          "sang = sin(ang);cang = cos(ang);",
          "xq = xp;",
          "yq = yp*cang - zp*sang;",
          "zq = yp*sang + zp*cang;",
          "xp=xq;yp=yq;zp=zq;",
          "",
          "//y axis rotation;",
          "ang = t1*2;",
          "sang = sin(ang);cang = cos(ang);",
          "xq = xp*cang - zp*sang;",
          "yq = yp;",
          "zq = xp*sang + zp*cang;",
          "xp=xq;yp=yq;zp=zq;",
          "",
          "//z axis rotation;",
          "ang = t1*3;",
          "sang = sin(ang);cang = cos(ang);",
          "xq = xp*cang - yp*sang;",
          "yq = xp*sang + yp*cang;",
          "zq = zp;",
          "xp=xq;yp=yq;zp=zq;",
          "",
          "//push forward into viewspace",
          "zp = zp*8 + q8;",
          "",
          "fov = 1; //larger number equal less extreme perspective (zoom in)",
