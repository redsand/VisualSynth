        "initCode": [],
        "perFrameCode": [
          null,
          "//// fish",
          "",
          "i=instance;",
          "sample=i/num_inst;",
          "",
          "fish=30;",
          "",
          "x = sample + .04*sin(10*sample+.2*time+13*sample);",
          "x = x +.2*sin(x+150*y-.16*time);",
          "",
          "y= .5+.5*sin(fish*((fish*sample)%fish)+.12*time) * ((fish*sample)%fish)/fish +.02*sin(fish*sample+.11*time);",
          "y= y-.4*sin((fish*sample)%fish+.08*time)-.3;",
          "",
          "rad=rad*sin(fish*3.14*(sample+.01));",
          "",
          "r=sample*fish;",
          "g=r;",
          "b=r;",
          "",
          "r2=25*sample+bass;",
          "g2=55*sample;",
          "b2=13*sample;"
        ],
        "perPointCode": []
      },
      {
        "enabled": true,
        "sides": 20,
        "additive": false,
        "thickOutline": false,
        "textured": false,
        "numInst": 200,
        "x": 0.5,
        "y": 0.13,
        "rad": 0.46288,
        "ang": 0,
        "texAng": 0,
        "texZoom": 1,
        "r": 0.5,
        "g": 1,
        "b": 1,
        "a": 0.7,
        "r2": 1,
        "g2": 1,
        "b2": 1,
        "a2": 0,
        "borderR": 1,
        "borderG": 1,
        "borderB": 1,
        "borderA": 0,
        "initCode": [],
        "perFrameCode": [
          null,
          "sample=1-instance/num_inst;",
          "",
          "///// dolphin with shapes",
          "",
          "s=8*sample;",
          "s1=rad*sin(8*3.14*sample);",
          "s2=rad*sin(.3+7*sample);",
          "",
          "/// body",
          "x=if(above(s,0),-3+2*s,0);",
          "y=if(above(s,0),1.5*sin(.05+s),0);",
          "z=if(above(s,0),0,0);",
          "rad=if(above(s,0),4*s2,0);",
          "",
          "/// finns",
          "x=if(above(s,3),-5.3+1.6*s,x);",
          "y=if(above(s,3),1.9-.8*sin(3.1+2*s),y);",
          "z=if(above(s,3),0,z);",
          "rad=if(above(s,3),2*s1,rad);",
          "",
          "x=if(above(s,4),-3.7+.5*s,x);",
          "y=if(above(s,4),3.4-.7*s,y);",
          "z=if(above(s,4),.2,z);",
          "rad=if(above(s,4),1*s1,rad);",
          "",
          "x=if(above(s,5),1.3-.5*s,x);",
          "y=if(above(s,5),-3.6+.7*s,y);",
          "z=if(above(s,5),-.2,z);",
          "rad=if(above(s,5),1*s1,rad);",
          "",
          "x=if(above(s,6),-4.4+1.2*s,x);",
          "y=if(above(s,6),.1,y);",
          "z=if(above(s,6),-9+1.5*s,z);",
          "rad=if(above(s,6),1.8*s1,rad);",
          "",
          "x=if(above(s,7),12.4-1.2*s,x);",
          "y=if(above(s,7),.1,y);",
          "z=if(above(s,7),-12+1.5*s,z);",
          "rad=if(above(s,7),1.8*s1,rad);",
          "",
          "////eyes",
          "x=if(above(.1,s),-2.4,x);",
          "y=if(above(.1,s),.7,y);",
          "z=if(above(.1,s),.1,z);",
          "rad=if(above(.1,s),.15,rad);",
          "",
          "x=if(above(.05,s),-2.4,x);",
          "y=if(above(.05,s),.7,y);",
          "z=if(above(.05,s),-.1,z);",
          "rad=if(above(.05,s),.15,rad);",
          "",
          "",
          "/////movement",
          "t=2*time;",
          "",
          "y=y+.7*sin(-.2*x*x*above(x,.3)+.05*x*x*below(x,-.7)-.01*x*x*below(x,1.4)+t);",
          "y=y-.7*sin(t);",
          "",
          "z=z+.2*sin(1.5*z*above(-1,x)*below(.1,s)+4*t);",
          "z=z-.2*sin(4*t);",
          "",
          "y=y+.2*sin(.3*(y)+t);",
          "",
          "my_x=-x;",
          "my_y=-y+3+6*sin(.17*time);",
          "my_z=-z+19;",
          "",
          "",
          "//// rotations",
          "",
          "d = 150;",
          "zoom = 5;",
          "",
          "w1 = 0;",
          "w2 = 0+.06*t;",
          "w3 = 0;",
          "",
          "x1 = cos(w1)*my_x + sin(w1)*my_y;",
          "y1 = -sin(w1)*my_x + cos(w1)*my_y;",
          "z1 = my_z;",
          "",
          "x2 = cos(w2)*x1 + sin(w2)*z1;",
          "z2 = -sin(w2)*x1 + cos(w2)*z1;",
          "y2 = y1;",
          "",
          "y3 = cos(w3)*y2 + sin(w3)*z2;",
          "z3 = -sin(w3)*y2 + cos(w3)*z2;",
          "x3 = x2;",
          "",
          "l = sqrt(x3*x3 + y3*y3);",
          "w = atan2(x3,y3);",
          "d = sqrt(x3*x3 + y3*y3 + (z3+d)*(z3+d));",
          "p = tan(asin(1) + atan2(d+z3,l));",
          "",
          "my_x = zoom*sin(w)*p;",
          "my_y = zoom*cos(w)*p;",
          "",
          "x = 0.5 + my_x/q6;",
          "y = 0.5 + my_y/q5;",
          "",
          "rad=rad*zoom/d;"
        ],
        "perPointCode": []
      }
