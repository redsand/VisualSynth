          "//pi",
          "t8=3.14159265;",
          "t5 = 1;"
        ],
        "perFrameCode": [
          null,
          "rotx = rotx+bass;",
          "roty = roty+mid;",
          "rotz = rotz+treb;",
          "",
          "//convert rotation values from degrees to radians",
          "t1= t8*rotx/180;",
          "t2 = t8*roty/180;",
          "t3 = t8*rotz/180;",
          ""
        ],
        "perPointCode": [
          null,
          "//Define 3D Shape",
          "",
          "//Sphere (Torus Code)",
          "x0 = (1+value1)*sin(2*t8*sample);",
          "y0 = (1+value1)*cos(2*t8*sample);",
          "x1 = (0.4+0.15*bass_att)*sin(8*t8*sample)*x0;",
          "y1 = (0.4+0.1*mid_att)*sin(8*t8*sample)*y0;",
          "z1= (0.4+0.05*treb_att)*cos(8*t8*sample);",
          "",
          "//modulate values to adjust for rotation on multiple axes, convert to world co-ordinates",
          "y2 = y1*cos(t1)-z1*sin(t1);",
          "z2 = y1*sin(t1)+z1*cos(t1);",
          "x2 = z2*sin(t2)+x1*cos(t2);",
          "z3 = z2*cos(t2)-x1*sin(t2);",
          "x3 = x2*cos(t3)-y2*sin(t3);",
          "y3 = y2*cos(t3)+x2*sin(t3);",
          "//move resulting shape in 3d space",
          "x4 = x3;",
          "y4 = y3;",
          "z4 = z3+4;",
          "//draw 3d shape in 2d",
          "x=0.5+0.5*(x4/(1+z4*0.5))+q2;",
          "y=0.5+0.5*(y4/(1+z4*0.5))+q3;",
          "",
          "tempr = min(1,0.6+0.5*(sin(0.362*(time+20*sample))+sin(0.224*(time+20*sample))));",
          "tempg = min(1,0.6+0.5*(sin(0.571*(time+20*sample))+sin(0.353*(time+20*sample))));",
          "tempb = min(1,0.6+0.5*(sin(0.789*(time+20*sample))+sin(0.183*(time+20*sample))));",
          "r = if(above(tempr,1),1,if(below(tempr,0),0,tempr));",
          "g = if(above(tempg,1),1,if(below(tempg,0),0,tempg));",
          "b = if(above(tempb,1),1,if(below(tempb,0),0,tempb));"
        ]
