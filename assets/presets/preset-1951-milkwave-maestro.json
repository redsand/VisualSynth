        "perPointCode": [
          null,
          "//....maestro wave....//",
          "",
          "it=it+1;",
          "x=pow(-1,it)*.05*sin(6.3*sample);",
          "y=.5+.05*cos(6.3*sample);",
          "",
          "x= if( above(sample,abs(sin(q11))), x+.1, x);",
          "x= if( above(sample,abs(sin(q12))), x+.2, x);",
          "x= if( above(sample,abs(sin(q13))), x+.3, x);",
          "x= if( above(sample,abs(sin(3+q11))), x+.4, x);",
          "x= if( above(sample,abs(sin(3+q12))), x+.5, x);",
          "x= if( above(sample,abs(sin(3+q13))), x+.6, x);",
          "",
          "b= if( above(sample,abs(sin(q11))), q12, q11);",
          "r= if( above(sample,abs(sin(q12))), q13, q12);",
          "g= if( above(sample,abs(sin(q13))), q11, q13);",
          "b= if( above(sample,abs(sin(3+q11))), q12, q11);",
          "r= if( above(sample,abs(sin(3+q12))), q13, q12);",
          "g= if( above(sample,abs(sin(3+q13))), q11, q13);",
          "",
          "",
          "//...rotations...(by Flexi)....//",
          "",
          "// 3D model coordinates",
          "my_x = x;",
          "my_y = y;",
          "my_z = 0;",
          "",
          "d = 3; // distance of the camera (on the z-axis) to the origin",
          "zoom = 1.4;",
          "",
          "// solid angles",
          "w1 = 0;",
          "w2 = q2;",
          "w3 = q1;",
          "",
          "// rotations",
          "x1 = cos(w1)*my_x + sin(w1)*my_y;",
          "y1 = -sin(w1)*my_x + cos(w1)*my_y;",
          "z1 = my_z;",
          "",
          "x2 = cos(w2)*x1 + sin(w2)*z1;",
          "z2 = -sin(w2)*x1 + cos(w2)*z1;",
          "y2 = y1;",
          "",
          "y3 = cos(w3)*y2 + sin(w3)*z2;",
          "z3 = -sin(w3)*y2 + cos(w3)*z2;",
          "x3 = x2;",
          "",
          "// perspective calculation",
          "",
          "l = sqrt(x3*x3 + y3*y3);",
          "w = atan2(x3,y3);",
          "p = tan(asin(1) + atan2(d+z3,l));",
          "d = sqrt(x3*x3 + y3*y3 + (z3+d)*(z3+d));",
          "",
          "my_x = zoom*sin(w)*p;",
          "my_y = zoom*cos(w)*p;",
          "",
          "x = 0.5 + my_x;",
          "y = 0.5 + my_y;"
        ]
      },
