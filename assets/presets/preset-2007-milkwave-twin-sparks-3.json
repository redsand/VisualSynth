        ],
        "perPointCode": [
          null,
          "////  code based on a flexi's wave",
          "",
          "it=it+1;",
          "",
          "sx = sample*(2-sample)*t1 + t3*(1-sample*sample) ;",
          "sy = sample*(2-sample)*t2 + t4*(1-sample*sample) ;",
          "",
          "my_x=-.5+sx;",
          "my_y=-.5+sy;",
          "my_z= value1+.01*pow(-1,it);",
          "",
          "/////// rotations... by flexi",
          "",
          "d = q16;",
          "zoom = 10;",
          "",
          "w1 = .6*time;",
          "w2 = .5*time;",
          "w3 = 1.1*w2;",
          "",
          "x1 = cos(w1)*my_x + sin(w1)*my_y;",
          "y1 = -sin(w1)*my_x + cos(w1)*my_y;",
          "z1 = my_z;",
          "",
          "x2 = cos(w2)*x1 + sin(w2)*z1;",
          "z2 = -sin(w2)*x1 + cos(w2)*z1;",
          "y2 = y1;",
          "",
          "y3 = cos(w3)*y2 + sin(w3)*z2;",
          "z3 = -sin(w3)*y2 + cos(w3)*z2;",
          "x3 = x2;",
          "",
          "l = sqrt(x3*x3 + y3*y3);",
          "w = atan2(x3,y3);",
          "d = sqrt(x3*x3 + y3*y3 + (z3+d)*(z3+d));",
          "p = tan(asin(1) + atan2(d+z3,l));",
          "",
          "mx = zoom*sin(w)*p;",
          "my = zoom*cos(w)*p;",
          "",
          "x = 0.5 + mx/q6;",
          "y = 0.5 + my/q5;",
          "",
          "x = 0.5 + (x-.5)/q5;",
          "y = 0.5 + (y-.5)/q6;",
          "",
          "",
          "a=above(.5,sin(.2*q12));"
        ]
      },
