    "perFrameCode": [
      "wave_a = 0;",
      "",
      "",
      "",
      "//Thanks to Zylot for rainbow generator",
      "counter1 = if(equal(counter2,1),if(equal(counter1,1),0,counter1+.2),1);",
      "counter2 = if(equal(counter1,1),if(equal(counter2,1),0,counter2+.2),1);",
      "cdelay1 = if(equal(cdelay2,1),1,if(equal(colorcounter%2,1),if(equal(counter1,1),2 ,0), if(equal(counter2,1),2,0)));",
      "cdelay2 = if(equal(cdelay1,2),1,0);",
      "colorcounter = if(above(colorcounter,7),0,if(equal(cdelay1,1),colorcounter+1,colorcounter));",
      "ob_r = .5*if(equal(colorcounter,1),1, if(equal(colorcounter,2),1, if(equal(colorcounter,3),1, if(equal(colorcounter,4),sin(counter2+2.1), if(equal(colorcounter,5),0, if(equal(colorcounter,6),0,sin(counter1)))))));",
      "ob_g = .5*if(equal(colorcounter,1),0, if(equal(colorcounter,2),sin(counter2*.5), if(equal(colorcounter,3),sin((counter1+1.75)*.4), if(equal(colorcounter,4),1, if(equal(colorcounter,5),1, if(equal(colorcounter,6),sin(counter2+2),0))))));",
      "ob_b = if(equal(colorcounter,1),sin(counter1+2.1), if(equal(colorcounter,2),0, if(equal(colorcounter,3),0, if(equal(colorcounter,4),0, if(equal(colorcounter,5),sin(counter1), if(equal(colorcounter,6),1,1))))));",
      "",
      "",
      "",
      "ib_r = ob_r*1.001;",
      "ib_g = ob_g*1.001;",
      "ib_b = ob_b*1.001;",
      "",
      "",
      "",
      "decay = 0.9999;",
      "",
      "",
      "",
      "",
      "",
      "basstemp= bass + bass_att + bass_thresh;",
      "trebtemp= treb + treb_att + treb_thresh;",
      "trasstemp= (max(basstemp, trebtemp));",
      "trassave= (trasstemp/3);",
      "",
      "basst= max(bass + bass_att, treb + treb_att);",
      "trebb= min(basst + bass_thresh, basst + treb_thresh);",
      "midbeat= trebb/3;",
      "midtb= max(midbeat + mid, midbeat + mid_att);",
      "mtb= midtb/2.25;",
      "",
      "beetA= (max(treb, bass) + min(treb_att, bass_att)) /2;",
      "beetB= (max(mid, beetA) + min(mid_att, beetA*0.5)) /2;",
      "beetAB= (beetA+beetB)/2;",
      "beetC= (max(mid, treb) + min(mid_att, treb_att)) /2;",
      "beetD= (max(bass, beetC) + min(bass_att, beetC*0.5)) /2;",
      "beetCD= (beetC+beetD)/2;",
      "beet= (beetAB+beetCD) /2;",
      "",
      "madbeat= (trassave+mtb+beet) /3;"
    ],
    "perFrameInitCode": [],
    "perPixelCode": [
      "rot = rot +.05 * sin(rad-(time*.1+bas))  ;",
      "bas =  (bass*2.5);",
      "tos = treb;",
      "bos = bass;",
      "warp = (bos + bass + bass) * .1;",
      "cx = (cx + treb) * .5;",
      "",
