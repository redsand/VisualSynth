        "perPointCode": [
          null,
          "",
          "///// counter (2 figures)",
          "",
          "s=14*sample;",
          "c1= above(s,7);",
          "c2= 7*c1-s;",
          "c = 7*c1-int(s);",
          "",
          "///  model (2 x 7 segments of number 8)",
          "xa=bnot(c)*(-c2);                                   ya=0;",
          "xb=0;                                               yb=bnot(c+1)*(-c2-2);",
          "xc=bnot(c+2);                                       yc=bnot(c+2)*(c2+2);",
          "xd=bnot(c+3)*(c2+4);                                yd=bnot(c+3)*(-1);",
          "xe=0;                                               ye=bnot(c+4)*(c2+3);",
          "xf=bnot(c+5);                                       yf=bnot(c+5)*(-c2-7);",
          "xg=bnot(c+6)*(-c2-6);                               yg=bnot(c+6)*(-2);",
          "",
          "x8=xa+xb+xc+xd+xe+xf+xg;                            y8=ya+yb+yc+yd+ye+yf+yg;",
          "",
          "///// timer",
          "",
          "t1=gmegabuf(ind)%10;",
          "t2=(.1*gmegabuf(ind))%10;",
          "",
          "",
          "",
          "x=   if(c1,bnot(t1),  bnot(t2))   *(x8-xd);         y=   if(c1,bnot(t1),  bnot(t2))   *(y8-yd);       /// 0",
          "x=x+ if(c1,bnot(t1-1),bnot(t2-1)) *(xb+xe);         y=y+ if(c1,bnot(t1-1),bnot(t2-1)) *(yb+ye);       /// 1",
          "x=x+ if(c1,bnot(t1-2),bnot(t2-2)) *(x8-xb-xf);      y=y+ if(c1,bnot(t1-2),bnot(t2-2)) *(y8-yb-yf);    /// 2",
          "x=x+ if(c1,bnot(t1-3),bnot(t2-3)) *(x8-xb-xe);      y=y+ if(c1,bnot(t1-3),bnot(t2-3)) *(y8-yb-ye);    /// 3",
          "x=x+ if(c1,bnot(t1-4),bnot(t2-4)) *(x8-xa-xe-xg);   y=y+ if(c1,bnot(t1-4),bnot(t2-4)) *(y8-ya-ye-yg); /// 4",
          "x=x+ if(c1,bnot(t1-5),bnot(t2-5)) *(x8-xc-xe);      y=y+ if(c1,bnot(t1-5),bnot(t2-5)) *(y8-yc-ye);    /// 5",
          "x=x+ if(c1,bnot(t1-6),bnot(t2-6)) *(x8-xc);         y=y+ if(c1,bnot(t1-6),bnot(t2-6)) *(y8-yc);       /// 6",
          "x=x+ if(c1,bnot(t1-7),bnot(t2-7)) *(xa+xc+xf);      y=y+ if(c1,bnot(t1-7),bnot(t2-7)) *(ya+yc+yf);    /// 7",
          "x=x+ if(c1,bnot(t1-8),bnot(t2-8)) *x8;              y=y+ if(c1,bnot(t1-8),bnot(t2-8)) *y8;            /// 8",
          "x=x+ if(c1,bnot(t1-9),bnot(t2-9)) *(x8-xe-xg);      y=y+ if(c1,bnot(t1-9),bnot(t2-9)) *(y8-ye-yg);    /// 9",
          "",
          "",
          "x= .85 + .025*x + c1*(.001*x+.05);",
          "y= .75 + .025*y + c1*(.001*y)"
        ]
