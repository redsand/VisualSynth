        "perFrameCode": [
          null,
          "i=instance;      sample=i/num_inst;",
          "",
          "",
          "//// Pong",
          "",
          "c=equal(i,0);",
          "",
          "x1=x1+.01/fps;    y1=y1+.015/fps;    y11=y1-.03/fps;   //// ball",
          "",
          "x2=.1+1.4*(q6-1);         y2=-.05;           //// paddle",
          "",
          "x3= (int(x1)-x1+(x1)%2)*pow(-1,1+x1%2);                //// reflections",
          "y3= (int(y1)-y1+(y1)%2)*pow(-1,1+y1%2);",
          "",
          "",
          "d=sqrt(sqr(x3-x2)+sqr(y3-y2));                         //// hit",
          "p=p+below(d,.15);",
          "y1=if(p%2,y11,y1);",
          "y3= (int(y1)-y1+(y1)%2)*pow(-1,1+y1%2);",
          "",
          "",
          "",
          "x=if(c, x3,x2);",
          "y=if(c, y3,y2);",
          "",
          "rad=rad*if(c,1,6);",
          "",
          "",
          "gmegabuf(ind)=p;"
        ],
