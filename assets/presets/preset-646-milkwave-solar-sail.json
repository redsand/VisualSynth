          null,
          "u = abs(cos(q1*0.1))*3.14159;",
          "v = abs(cos(q1*0.015))*3.14159*2;",
          "s = sample*3.14*100;",
          "ss = sample*6.28*1000;",
          "",
          "zg = sample*0.1;",
          "",
          "angfast = sin(sample*6.28 + q1*0.2)*30.28;",
          "",
          "//draw 1 torus",
          "xtor = (0.6 + 0.1*cos(s))*cos(ss);",
          "ytor = (0.6 + 0.1*cos(s))*sin(ss);",
          "ztor = 0.1*sin(s);",
          "",
          "//draw 2 sphere",
          "xsph = 0.6*sin(s)*cos(ss);",
          "ysph = 0.6*sin(s)*sin(ss);",
          "zsph = 0.6*cos(s)*zg*cos(angfast);",
          "",
          "//draw 3 double cone",
          "xcon = 0.6*sin(s)*cos(ss);",
          "ycon = 0.6*sin(s)*sin(ss);",
          "zcon = 0.6*sin(s)*zg*cos(angfast);",
          "",
          "//draw 4 cylinder (kinda)",
          "xcyl = 0.6*sin(s);",
          "ycyl = 0.6*cos(s);",
          "zcyl = 0.6*cos(ss)*1.2;",
          "",
          "",
          "//warp",
          "//use simple fuzzy logic to model zooming",
          "//activations approx sawtooth with sin curve",
          "f1 = sin(q5*0.1 - 1.5707);",
          "f2 = sin(q5*0.1);",
          "f3 = sin(q5*0.1 + 1.5707);",
          "f4 = sin(q5*0.1 + 3.14);",
          "",
          "//take only values above zero",
          "f1 = f1*above(f1,0);",
          "f2 = f2*above(f2,0);",
          "f3 = f3*above(f3,0);",
          "f4 = f4*above(f4,0);",
          "",
          "",
          "xs = f1*xsph + f2*xtor - f3*xcon + f4*xcyl;",
          "ys = f1*ysph + f2*ytor - f3*ycon + f4*ycyl;",
          "zs = f1*zsph + f2*ztor - f3*zcon + f4*zcyl;",
          "",
          "",
          "//rotate x axis",
          "angle = sin(q5*0.055)*6.28;",
          "yx = ys*cos(angle) - zs*sin(angle);",
          "zx = ys*sin(angle) + zs*cos(angle);",
          "xx = xs;",
          "",
          "//rotate y axis",
          "angle2 = sin(q5*0.03)*6.28;",
          "xd = xx*cos(angle2) - zx*sin(angle2);",
          "zd = xx*sin(angle2) + zx*cos(angle2);",
          "yd = yx;",
          "",
          "//rotaye z axis",
          "angle3 = sin(q5*0.042)*6.28;",
          "xn = xd*cos(angle3) - yd*sin(angle3);",
          "yn = xd*sin(angle3) + yd*cos(angle3);",
          "",
          "zd = zd;",
          "",
          "x = xn*zd*0.9 + 0.5;",
          "y = yn*zd*1.2*0.9 + 0.5;",
          "",
          "r = 0.5 + 0.5*sin(q5*1.2 + x + x);",
          "g = 0.5 + 0.5*sin(q5*1.5 + x + y);",
          "b = 0.5 + 0.5*sin(q5*1.36 + y + y);"
        ]
