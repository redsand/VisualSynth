  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nfloat MinDist (vec2 uvi)\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  float limit, dist, struc, len; vec2 uv0, uv1; vec3 uv2; vec4 box;\nconst mat3 RotMat = mat3(q20,q21,q22,q23,q24,q25,q26,q27,q28);\nconst vec3 CamPos = vec3(q4,q5,q6);\nconst float myzoom = q7,  res = 128, res2 = 64, tele = q16;\nconst float sustain = .98 - q14, change = q14, ds = q10, tic8 = 1.0/255, ffac = q17;\nvec2 fstep2 (vec2 xy) {return 1.0/res*round(res*xy);}\nfloat GetDist(vec2 uvi) {vec2 tmp; tmp = fstep2(texture(sampler_pc_main, uvi).gb);\n  return 1-(tmp.y + 1.0/res2*(tmp.x-.50));}\nvec2 PutDist(float x) {float tmp; tmp = fstep2(1-x);\n  return (vec2(res2*((1-x)-tmp)+.5,tmp));}\n{\n   float tmp; vec4 nb; vec4 nb2; vec2 pix;\n   pix = uTexSize.zw*(1+length(uvi-0.5)*.0);\n   nb.x = GetDist(uvi+pix*vec2(-1,-1));   nb.y = GetDist(uvi+pix*vec2(1,-1));\n   nb.z = GetDist(uvi+pix*vec2(1,1));     nb.w = GetDist(uvi+pix*vec2(-1,1));\n   nb2.x = GetDist(uvi+pix*vec2(0,-1));   nb2.y = GetDist(uvi+pix*vec2(1,0));\n   nb2.z = GetDist(uvi+pix*vec2(0,1));    nb2.w = GetDist(uvi+pix*vec2(-1,0));\n   //Eo.S. more efficient usage of min to get min value of all 8 GetDist() calls, removes 11ALU\n   nb = min( nb, nb2 );\n   nb.xy = min( nb.xy, nb.zw );\n   return min( nb.x, nb.y );\n}\nvec3 Get1 (vec2 uvi) {return mix(GetPixel(uvi), GetBlur1(uvi),change*2);}\nvec4 mbox (vec3 uvi) {vec3 zz, zz0; float tmp, li;\n  zz = uvi; zz0 = zz+q8; li=0; int iterations = 8 - (dist>.8);\n  for (int n = 0; n <= iterations; n++) {\n    zz = 2.0*clamp(zz,-1,1)-zz;  tmp = dot(zz,zz);\n    zz *= clamp(max(.25/tmp, .25), 0.0, 1.0)*4; //############\n    zz = ffac*zz + zz0 ;}\nreturn vec4(zz,li);}\nuv0 = uv_orig;\nuv = (uv-.5)*(1-ds/(1-GetBlur1(uv).b)) + .5;\nuv1 = (uv0-.5)*uAspect.xy*tele;\nvec3 noise = fract(8*texture(sampler_noise_lq,uv+rand_frame.yz));\n\n   if (noise.g > .4*rad)\n   {\n       vec3 noiseBiased = noise - vec3( 0.5, 0.5, 0.5 );\n      //Eo.S. combine the subtraction on noise to a single vec3\n      //to ensure compiler does the subtraction in a single ALU\n      dist = MinDist(uv) +  0.006 * (noiseBiased.x) * abs(noiseBiased.y);\n   }\n   else {dist = noise.r;}\ndist = min(dist,GetDist(uv)) - ds*.8;\n\nlimit = 15 + 10 * dist;\nfloat tdist = dist+.000;\nuv2 = multiply(vec3(uv1*tdist,tdist)/myzoom,RotMat)+CamPos;\nuv2 = (fract(uv2/8.0+.5)-.5)*8.0;\nbox = mbox (uv2);\nlen = (length(box.xyz));\nstruc = length(box.xz) /limit;\n\nvec3 inside  = vec3 ((1-sustain)*struc+sustain*(Get1(uv).r), PutDist(dist));\nvec3 outside = Get1(uv)*vec3(sustain,1,sustain*0+1)-vec3(tic8,0,change/4*0+tic8*4*(.2+rad));\nret = mix(inside,outside,clamp01(1*(len-limit+struc*-0)));\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\n//-------------------------------------------\n//Written by martin\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  #define sat clamp01\nsampler sampler_pw_noise_lq;\nconst vec2 pix = uTexSize.zw;\nfloat glow, tmp, lamp, dist, bdist, b2dist, dist_c, cloud, inten, z;\nvec2 dz, uv1,uv2, uv3, uv4;\nconst vec3 CamPos = vec3(q4,q5,q6);\nconst float myzoom = q7;\nconst mat3 RotMat = mat3(q20,q21,q22,q23,q24,q25,q26,q27,q28);\nconst vec3 col_struc =  vec3(1,.7,.3) + .2*(rand_preset.xyz-.5);\nvec3 GetBlurX (vec2 uvi, float x) {return mix(GetPixel(uvi), GetBlur1(uvi), x);}\nfloat GetDist(vec2 uvi)   {return 1-GetPixel(uvi).b;}\nfloat GetDistB(vec2 uvi)  {return 1-GetBlur1(uvi).b;}\nfloat GetDistB2(vec2 uvi) {return 1-GetBlur2(uvi).b;}\nfloat MinDistB (vec2 uvi) {float tmp; vec4 nb; //##nicht ideal\n  tmp = GetDist(uvi);\n  tmp = min(tmp,GetDistB2(uvi)*1) ;\n  return tmp;}\nfloat noise4 (vec2 uvi) { float n1,n2,n3,n4,zv; zv = 0.008*uTime;\n  n1 = lum(texture(sampler_noise_hq, (uvi)));\n  n2 = lum(texture(sampler_noise_hq, (uvi*2+zv)));\n  n3 = lum(texture(sampler_noise_hq, (uvi*4+2*zv)));\n  n4 = lum(texture(sampler_noise_hq, (uvi*8+4*zv)));\n  return n1 + n2/2 + n3/4 + n4/8;}\nfloat shadow (vec2 uvi) {int n; float dark, dx; vec2 uvc;\n  dark = 0; n = 1;\n  while ( (n <= 8))\n     {dx = .002*n;\n      uvc = uvi + vec2(dx,0);\n      dark = dark + (GetDistB(uvi)-GetDistB(uvc) <= dx*4);\n      n++;\n     ;}\n  return dark/8;\n}\nuv1= (uv-.5)*uAspect.xy;\nuv1 = uv*uAspect.xy-vec2(.5,.5);\n\n\ndist = MinDistB(uv);\nbdist = mix(dist,GetDistB(uv),.5);\nfloat struc0 = GetBlurX(uv,bdist).r;\nfloat struc = struc0 * (1-bdist)*bdist;\n\ntmp = 0;\nfor (int k = 1; k <= 1; k++) {\n  uv2 = (uv1*(1-.1*tmp))*.2-vec2(q11,q12)*.2;\n  tmp = clamp01(lum(texture(sampler_noise_hq,uv2 +.03*noise4(uv2*4))-.4));}\ntmp = clamp01(pow(tmp,1.2) * sign(tmp));\n\nvec3 ret1 = vec3 (0.1,0.1,1.2-uv.y)+.07 + sat(bdist*2-1.5)*tmp*4;;\n\n//ret1 = 0;\nint anz = 3; float t_rel = q13*6;\nfor (int n=1;n<=anz;n++) {\n//    int m =  n-int(t_rel);\n\n    z = 1-fract(1.0*n/anz-1.0*fract(-t_rel)/anz);\n\n    inten =  (1-z)*z*2;\n    tmp = 0;\n    for (int k = 1; k <= 1; k++) {\n      uv2 = z*(uv1*(1-.1*tmp))/4-vec2(q11,q12)/6;\n      tmp = clamp01(lum(texture(sampler_noise_hq,uv2 +.03*noise4(uv2*4))-z*.5-.3)+0*struc);}\n    tmp = clamp01(pow(tmp,1) * sign(tmp)) *inten*(1+struc*0)*q1*2;\n\n    ret1 = (ret1+struc*4*q1*vec3(1,.75,.2))*sat(1-tmp) + tmp;\n}\n\n\nret = 1-exp((-1.6)*ret1);\n  fragColor = ret;\n}",
    "perFrameCode": [
      "fps_ = .0 * fps_ + 1*if(fps<=25,fps,25+.5*(fps-25));",
      "dec_s = 1-.03*30/fps_;",
      "dec_m = 1-.1*30/fps_;",
      "beat = (time >  t0+3); t0 = if(beat, time, t0);",
      "",
      "speed = min(0.2,dist_-.02) * (1+2*avg) *(1-slow*.0)*.1/q7; //#",
      "ds = ds * dec_s + (1-dec_s)*speed*.4/fps_;",
      "RotZ = if (travel > 2,.5,0);",
      "vol = vol*dec_m + (1-dec_m)*(bass_att +mid_att + treb_att)/4;",
      "q1 = vol/2+.3;",
      "//Position",
      "DirX= reg26; DirY= reg27; DirZ = reg28;",
      "PosX = PosX + ds*DirX ; PosY = PosY + ds*DirY; PosZ = PosZ + ds*DirZ;",
      "q4 = PosX; q5 = PosY; q6 = PosZ;",
      "",
      "angchg = (.1-dist_)*(dist_ < .1);",
      "travel = if (angchg > 0,0,travel+ds);",
      "v1 = v1 * dec_s + (1-dec_s)* RotZ * ds/2;",
      "v2 = v2 *dec_s + (1-dec_s)*angchg *xslope/fps_;",
      "v3 = v3 *dec_s + (1-dec_s)*(angchg *yslope/fps_ + 2*v1*sin(time*.1));",
      "//v1 = 0.00;",
      "//push old RotMat",
      "reg30 =reg20; reg31 =reg21; reg32 =reg22;",
      "reg33 =reg23; reg34 =reg24; reg35 =reg25;",
      "reg36 =reg26; reg37 =reg27; reg38 =reg28;",
      "",
      "n = 0; avg = 0;",
      "loop (5,",
      "  n = n+1;",
      "  //new Rot. Mat for infinitesimal angles",
      "  ran1 = rand(100)/100;",
      "  ran2 = rand(100)/200-.25;",
      "  tx = cos(n*1.57+ran2) * (n <= 4)*ran1; ty = sin(n*1.57+ran2) * (n <= 4)*ran1;",
      "  c1 = cos(v1); c2 = cos(v2+ty); c3 = cos(v3+tx);",
      "  s1 = sin(v1); s2 = sin(v2+ty); s3 = sin(v3+tx);",
      "  reg10 = c2*c1; reg11 = c2*s1; reg12 = -s2;",
      "  reg13 = s3*s2*c1 - c3*s1; reg14 = s3*s2*s1 + c3*c1; reg15 = s3*c2;",
      "  reg16 = c3*s2*c1 + s3*s1; reg17 = c3*s2*s1 - s3*c1; reg18 = c3*c2;",
      "",
      "  //pop old RotMat",
      "  reg20 =reg30; reg21 =reg31; reg22 =reg32;",
      "  reg23 =reg33; reg24 =reg34; reg25 =reg35;",
      "  reg26 =reg36; reg27 =reg37; reg28 =reg38;",
      "",
      "  //Multiply new RotMat by old one",
      "  q20 = reg10*reg20 + reg11*reg23 + reg12*reg26;",
      "  q21 = reg10*reg21 + reg11*reg24 + reg12*reg27;",
      "  q22 = reg10*reg22 + reg11*reg25 + reg12*reg28;",
      "  q23 = reg13*reg20 + reg14*reg23 + reg15*reg26;",
      "  q24 = reg13*reg21 + reg14*reg24 + reg15*reg27;",
      "  q25 = reg13*reg22 + reg14*reg25 + reg15*reg28;",
      "  q26 = reg16*reg20 + reg17*reg23 + reg18*reg26;",
      "  q27 = reg16*reg21 + reg17*reg24 + reg18*reg27;",
      "  q28 = reg16*reg22 + reg17*reg25 + reg18*reg28;",
      "",
      "  reg20 =q20; reg21 =q21; reg22 =q22;",
      "  reg23 =q23; reg24 =q24; reg25 =q25;",
      "  reg26 =q26; reg27 =q27; reg28 =q28;",
      "",
      "  //***********BOT*************",
      "  //Coord. Trans. must exactly match def in warp S. !!!!",
      "  dist = 0.002;",
      "  while (exec2(",
      "    uvx = reg26*dist/q7; uvy = reg27*dist/q7; uvz = reg28*dist/q7;",
      "    uvx += PosX; uvy += PosY; uvz += PosZ;",
      "    uvx = 8.0*((uvx/8+30.5 - int(uvx/8+30.5))-.5);",
      "    uvy = 8.0*((uvy/8+30.5 - int(uvy/8+30.5))-.5);",
      "    uvz = 8.0*((uvz/8+30.5 - int(uvz/8+30.5))-.5);",
      "    uvx0 = uvx+q8; uvy0 = uvy+q8; uvz0 = uvz+q8;",
      "    loop (7+1,",
      "      uvx = if (uvx > 1, 2-uvx, if(uvx < -1, -2-uvx, uvx));",
      "      uvy = if (uvy > 1, 2-uvy, if(uvy < -1, -2-uvy, uvy));",
      "      uvz = if (uvz > 1, 2-uvz, if(uvz < -1, -2-uvz, uvz));",
      "      slen = uvx*uvx + uvy*uvy + uvz*uvz;",
      "      uvx = if (slen < 0.25, uvx*4, if (slen < 1, uvx/slen, uvx)) *q17 + uvx0;",
      "      uvy = if (slen < 0.25, uvy*4, if (slen < 1, uvy/slen, uvy)) *q17 + uvy0;",
      "      uvz = if (slen < 0.25, uvz*4, if (slen < 1, uvz/slen, uvz)) *q17 + uvz0;",
      "    );",
      "    len = sqrt(uvx*uvx + uvy*uvy + uvz*uvz);",
      "    dist *= 1.1;",
      "  ,(dist < 0.6)*(len > 30)));",
      "  megabuf(n) = megabuf(n)*dec_s + (1-dec_s)*dist; //stores the 4 trial points",
      "  avg = avg+abs(megabuf(n)/5);",
      "); //end loop 5",
      "",
      "n = 0; avg = 0; loop (5, n=n+1; avg = avg+abs(megabuf(n)/5));",
      "",
      "xslope = min(max(2/avg*(megabuf(1)-megabuf(3)),-3),3);",
      "yslope = min(max(2/avg*(megabuf(4)-megabuf(2)),-3),3);",
      "monitor = avg;",
      "dist_ = dist_*dec_s + (1-dec_s)*dist;",
      "",
      "q10 = ds*q7; //compensation of lin. movement in GetDist and zoom uv",
      "q14 = 1*abs(ds) + 2*(abs(v1) + abs(v2) + abs(v3)) + start*.05;",
      "q19 = .6 + .4*sin(time*.02+cran0*6); //brightness backgd",
      "start = start * .9;",
      "",
      "warp = 0.0; zoom = 1;",
      "dx = -v2/q16; dy = v3/q16; rot = v1;",
      "vx = vx -v2/q16; vy = vy +v3/q16; vz = vz + v1;",
      "q11 = vx;  q12 = vy;",
      "movz = movz + ds;",
      "q13 = movz;",
      "monitor = q13;"
    ],
    "perFrameInitCode": [
      "",
      "//******** INITIALIZATION *********",
      "//---------- some global vars, do not change -------------",
      "avg = 0.01;",
      "q7 = .2; //MyZoom",
      "q8 =  rand(200)/100-1; //fractal modifier",
      "//q8 = -0; //#",
      "q16 = 1.2; //Tele",
      "q18 = rand(0.8)+.1; //brightness balance back/front",
      "q17 = 2.6; //fractal density factor ffac",
      "start = 1; travel = 0; RotZ = 0; look = 0; slow = 0; t0 = time+3; lampx = .5; lampy = .5;",
      "cran0 = rand(1);",
      "n = 0; loop (10000, gmegabuf(n)=0; n=n+1; );",
      "n = 0; loop (10000,  megabuf(n)=0; n=n+1; );",
      "trelx = 0;  trely = 0; trelz = 0;",
      "reg20 = 1; reg21 = 0; reg22 = 0; reg23 = 0; reg24 = 1; reg25 = 0; reg26 = 0; reg27 = 0; reg28 = 1;",
      "",
      "//Find random starting point",
      "while (exec2(",
      "  ran1 = rand(800)/100;  ran2 = rand(800)/100;  ran3 = rand(800)/100;",
      "  PosX = rand(10)-5;   PosY = rand(10)-5;   PosZ = rand(10)-5;",
      "",
      "//  PosX = 3.3; PosY = 2; PosZ = -2; ran1 = 0; ran2 = 0; ran3 = 0; //#",
      "",
      "  c1 = cos(ran1); c2 = cos(ran2); c3 = cos(ran3);",
      "  s1 = sin(ran1); s2 = sin(ran2); s3 = sin(ran3);",
      "",
      "  reg20 = c2*c1; reg21 = c2*s1; reg22 = -s2;",
      "  reg23 = s3*s2*c1 - c3*s1; reg24 = s3*s2*s1 + c3*c1; reg25 = s3*c2;",
      "  reg26 = c3*s2*c1 + s3*s1; reg27 = c3*s2*s1 - s3*c1; reg28 = c3*c2;",
      "",
      "  //***********BOT*************",
      "  //Coord. Trans. must exactly match def in warp S. !!!!",
      "  dist = 0.001;",
      "  while (exec2(",
      "    uvx = reg26*dist/q7; uvy = reg27*dist/q7; uvz = reg28*dist/q7;",
      "    uvx += PosX; uvy += PosY; uvz += PosZ;",
      "    uvx = 8.0*((uvx/8+30.5 - int(uvx/8+30.5))-.5);",
      "    uvy = 8.0*((uvy/8+30.5 - int(uvy/8+30.5))-.5);",
      "    uvz = 8.0*((uvz/8+30.5 - int(uvz/8+30.5))-.5);",
      "    uvx0 = uvx+q8; uvy0 = uvy+q8; uvz0 = uvz+q8;",
      "    loop (7+1,",
      "      uvx = if (uvx > 1, 2-uvx, if(uvx < -1, -2-uvx, uvx));",
      "      uvy = if (uvy > 1, 2-uvy, if(uvy < -1, -2-uvy, uvy));",
      "      uvz = if (uvz > 1, 2-uvz, if(uvz < -1, -2-uvz, uvz));",
      "      slen = uvx*uvx + uvy*uvy + uvz*uvz;",
      "      uvx = if (slen < 0.25, uvx*4, if (slen < 1, uvx/slen, uvx)) *q17 + uvx0;",
      "      uvy = if (slen < 0.25, uvy*4, if (slen < 1, uvy/slen, uvy)) *q17 + uvy0;",
      "      uvz = if (slen < 0.25, uvz*4, if (slen < 1, uvz/slen, uvz)) *q17 + uvz0;",
      "    );",
      "    len = sqrt(uvx*uvx + uvy*uvy + uvz*uvz);",
      "    dist *= 1.05;",
      "  ,(dist < 0.6)*(len > 30)));",
