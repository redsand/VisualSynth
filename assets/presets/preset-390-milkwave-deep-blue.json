  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  vec3 color, mus;\nfloat dx,dy;\nfloat corr = uTexSize.xy*texsize_noise_lq.zw;\n\nvec2 uv1 = (uv-.5);\nvec2 uv6 = uv1;\n\nfloat rota = lum(texture(sampler_noise_hq,uv/4))*q31;\n\nuv6 = multiply(uv1,mat2(cos(rota),-sin(rota),sin(rota),cos(rota)));\nuv6 += sin(q32*uv1);\nmus = .2/(sqrt(uv6.x)+.2);\n\nmus *= vec3 (1.1,1,.95);\nmus *= .9+.1*texture(sampler_noise_hq,uv);\n\nvec3 blur = GetBlur1(fract(uv));\n\nvec2 hor = vec2 (0.005,0);\nvec2 ver = vec2 (0,.005);\n\nfloat dx = lum(texture(sampler_main,uv+hor)\n         - texture(sampler_main,uv-hor));\nfloat dy = lum(texture(sampler_main,uv+ver)\n         - texture(sampler_main,uv-ver));\n\n\nvec2 zz = vec2 (dx,dy);\n\nvec3 crisp= texture(sampler_main,uv+zz*.02);\nvec3 crisp2 = texture(sampler_main,uv);\ncrisp += crisp2/2;\ncrisp *= .67;\ncrisp +=.08 * mus - length(zz)*blur;\n\nvec3 ret1 = crisp - lum(blur)*.04;\nret = ret1 * q10 -  .04 ;\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  vec3 ret1, neu, neu2, glow, sky;\nvec2 uv1,uv2,uv3,uv4,uv5,rs,zz;\nfloat k,m,n,zoom,dist,dist2,inten,mask,dx,dy;\nmat2 dir;\nint i, anz;\nuv -= 0.5;\nuv *= uAspect.xy;\nvec2 hor = vec2 (0.004,0);\nvec2 ver = vec2 (0,.004);\n\nret1 = 0; anz = 3;\nfloat t_rel = q29;\n\n\nfor (n=1;n<=anz;n++) {\n    m =  n-int(t_rel);\n\n    dist = 1-fract(n/anz-fract(-t_rel)/anz);\n    zoom = 2 ;\n    dist2 = dist*dist;\n    inten =  pow(dist,.3)*(1-dist2);\n\n    uv2 =zoom*dist*(uv -.4)-.1; //Blickpunkt vert.\n    uv3 = fract(uv2+(m+q28)*vec2(.4,1));\n\n    dx = lum(GetPixel(uv3+hor)\n        - GetPixel(uv3-hor));\n    dy = lum(GetPixel(uv3+ver)\n         - GetPixel(uv3-ver));\n\n    zz = vec2 (dx,dy);\n    neu = GetPixel (uv3+.5*zz);\n    glow = GetBlur1(uv3) * vec3 (.5,1,1);\n\n    mask = 1-clamp01(8*neu);\n    ret1 = ret1*mask + (neu+2*glow)*inten;\n//n++;\n}\n\nuv1 = uv + vec2(2*fract(.003*uTime)-.55,.25) - ret1/8;\nfloat moon = clamp01(.01/length(uv1));\n\n\nfloat mask = clamp01(1-2*ret1.r);\nsky = .4*clamp01(.4-uv.y) * vec3 (.2,0.3,1);\nret = ret1*vec3(0,1,1)+ sky*mask;\nret = ret + 8*ret*moon;\n\n//ret = GetPixel(uv+.5)*2;\n  fragColor = ret;\n}",
    "perFrameCode": [
      "dec_med = pow (0.9, 30/fps);",
      "dec_slow = pow (0.99, 30/fps);",
      "beat = max (max (bass, mid), treb);",
      "avg = avg*dec_slow + beat*(1-dec_slow);",
      "is_beat = above(beat, .5+avg+peak) * above (time, t0+.2);",
      "t0 = is_beat*time + (1-is_beat)*t0;",
      "peak = is_beat * beat + (1-is_beat)*peak*dec_med;",
      "index = (index + is_beat) %8;",
      "",
      "q20 = avg;",
      "q21 = beat;",
      "q22 = peak;",
      "q23 = index;",
      "q24 = is_beat;",
      "q26 = bass + mid + treb;",
      "",
      "k1 =  is_beat*equal(index,0);",
      "p1 =  k1*(p1+1) + (1-k1)*p1;",
      "",
      "p2 = dec_med * p2+ (1-dec_med)*p1;",
      "p3 = dec_med * p3+ (1-dec_med)*p2;",
      "rott = p3 * 3.1416/2;",
      "q27 = index + 1;",
      "",
      "movz = movz + .001*30/fps*(1.5+sin(rott));",
      "q29 = movz ;",
      "",
      "",
      "movx = movx + .001*30/fps*(1+sin(time/7));",
      "q28 = movx;",
      "",
      "",
      "q30 = .5 * (sin(time/19)+1);",
      "q31 = 3*(sin(time/23)+2);",
      "q32 = sin(time/17)+1;",
      "",
      "",
      "fade = fade * dec_med + .98 * (1-dec_med);",
      "q10 = fade;",
      "",
      ""
    ],
    "perFrameInitCode": [
