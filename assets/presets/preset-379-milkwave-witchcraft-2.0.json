  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  vec2 d = uTexSize.zw * 8;\n    vec3 dx = ( GetBlur1(uv + vec2(1,0)*d) - GetBlur1(uv-vec2(1,0)*d) );\n    vec3 dy = ( GetBlur1(uv + vec2(0,1)*d) - GetBlur1(uv-vec2(0,1)*d) );\n\n    vec2 dither_uv = uv_orig*uTexSize.xy*texsize_noise_lq.zw * 1.2 + rand_frame.xy;\n\n    vec2 uv_x= mix(uv_orig,uv,0.1)  + vec2(dx.x,dy.x)*uTexSize.zw  *2;\n    vec2 uv_y= mix(uv_orig,uv,0.3)  + vec2(dx.y,dy.y)*uTexSize.zw  *2;\n    vec2 uv_z= mix(uv_orig,uv,0.1)  + vec2(dx.z,dy.z)*uTexSize.zw  *2;\n    ret.x = GetPixel(uv_x).x - (GetPixel(uv_x) - GetBlur3(uv_x)).x  * 0.01;\n    ret.y = GetPixel(uv_y).y - (GetPixel(uv_y) - GetBlur3(uv_y)).y  * 0.01;\n    ret.z = GetPixel(uv_z).z - (GetPixel(uv_z) - GetBlur3(uv_z)).z  * 0.01;\n\n    ret += - 0.004  +(texture(sampler_noise_lq, dither_uv).xyz-0.5) *0.1;\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  sampler sampler_manyfish;\nvec2 d = uTexSize.zw*8;\n    vec3 dx = ( GetBlur1(uv+vec2(1,0)*d)-GetBlur1(uv-vec2(1,0)*d) );\n    vec3 dy = ( GetBlur1(uv+vec2(0,1)*d)-GetBlur1(uv-vec2(0,1)*d) );\n\n    vec2 uv_dz = uv - vec2(dx.z,dy.z)*0.2;\n    vec2 uv_dy = uv - vec2(dx.y,dy.y)*0.04;\n    float emboss = (-dx.y+dy.y) + 1 + (-dx.z + dy.z)*2;\n\nret = GetPixel(uv).y*0.2;\nret = mix(vec3(0.2,0,0.1),vec3(0.8,0.6,0),GetPixel(uv_dz).y);\nret *= emboss;\nret = mix(ret,vec3(0.3,0,0.8),GetBlur1(uv_dy).x*1.4);\nret = mix(ret,vec3(1,0.9,0.4),GetPixel(uv).z*1);\n  fragColor = ret;\n}",
    "perFrameCode": [
      "dec_med = pow (0.9, 30/fps);",
      "dec_slow = pow (0.99, 30/fps);",
      "beat = max (max (bass, mid), treb);",
      "avg = avg*dec_slow + beat*(1-dec_slow);",
      "is_beat = above(beat, .5+avg+peak) * above (time, t0+.2);",
      "t0 = is_beat*time + (1-is_beat)*t0;",
      "peak = is_beat * beat + (1-is_beat)*peak*dec_med;",
      "index = (index + is_beat) %2;",
      "",
      "",
      "d_x = if(is_beat, (rand(2000)-1000)*0.001 , d_x);",
      "d_y = if(is_beat, (rand(2000)-1000)*0.001 , d_y);",
      "r = if(is_beat, (rand(2000)-1000)*0.001 , r);",
      "z = if(is_beat, rand(1000)*0.001 , z);",
      "zoom = 1.03 + z*0.06;",
      "rot = r*0.06;",
      "dx = d_x*0.01;",
      "dy = d_y*0.01;",
      "q1 = 1;",
      "",
      "q23 = rand(1000)/1000;",
      "q24 = rand(1000)/1000;",
      "q25 = (rand(1000)/1000)*6.28;",
      "q26 = q25 - 3.14;",
      "q27 = (rand(1000)/12000)+0.04;",
      "",
      "q28 = rand(1000)/1000;",
      "q29 = rand(1000)/1000;",
      "q30 = (rand(1000)/1000)*6.28;",
      "q31 = q30 - 3.14;",
      "q32 = (rand(1000)/14000)+0.04;",
      "",
      "db = db*0.98 + bass*0.2;",
      "bb = bb + db*0.1;",
      "",
      "dt = dt*0.98 + treb*0.2;",
      "tt = tt + dt*0.1;",
      "",
      "dm = dm*0.98 + mid*0.2;",
      "mm = mm + dm*0.1;",
      "",
      "",
      "w = (bb-tt)*0.1;",
      "q11 = sin(w);",
      "q12 = cos(w);",
      "q13 = 0.5 + sin((bb-mm)*0.1)*0.25; // cx",
      "q14 = 0.5 + sin((tt-mm)*0.1)*0.25; // cy",
      "q15 = 4;",
      "q16 = 0.06;",
      "q17 = sin(-w);",
      "q18 = cos(-w);"
    ],
