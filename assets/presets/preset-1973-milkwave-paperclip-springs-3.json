          null,
          "sample=instance/num_inst;",
          "",
          "//// paperclip",
          "",
          "s=7*sample;      p=-int(s);",
          "",
          "x=  bnot(p+0)*(-1+2*s);                y=  bnot(p+0)*(-.5);",
          "x=x+bnot(p+1)*(1-.5*sin(3.14*s));      y=y+bnot(p+1)*(-.5*cos(3.14+3.14*s));",
          "x=x+bnot(p+2)*(5-2*s);                 y=y+bnot(p+2)*(.5);",
          "x=x+bnot(p+3)*(-1+.4*sin(3.14*s));     y=y+bnot(p+3)*(.1-.4*cos(3.14*s));",
          "x=x+bnot(p+4)*(-9+2*s);                y=y+bnot(p+4)*(-.3);",
          "x=x+bnot(p+5)*(.95-.3*sin(3.14*s));    y=y+bnot(p+5)*(-.3*cos(3.14+3.14*s));",
          "x=x+bnot(p+6)*(11.75-1.8*s);           y=y+bnot(p+6)*(.3);",
          "x=x+bnot(p+7)*(-.85);                  y=y+bnot(p+7)*(.3);",
          "",
          "my_x=x;",
          "my_y=y;",
          "my_z=0;",
          "",
          "",
          "//// rotations",
          "",
          "d = 50;",
          "zoom = 1;",
          "",
          "w1 = .6*time;",
          "w2 = sin(2*time);",
          "w3 = sin(-2.2*time);",
          "",
          "x1 = cos(w1)*my_x + sin(w1)*my_y;",
          "y1 = -sin(w1)*my_x + cos(w1)*my_y;",
          "z1 = my_z;",
          "",
          "x2 = cos(w2)*x1 + sin(w2)*z1;",
          "z2 = -sin(w2)*x1 + cos(w2)*z1;",
          "y2 = y1;",
          "",
          "y3 = cos(w3)*y2 + sin(w3)*z2;",
          "z3 = -sin(w3)*y2 + cos(w3)*z2;",
          "x3 = x2;",
          "",
          "l = sqrt(x3*x3 + y3*y3);",
          "w = atan2(x3,y3);",
          "d = sqrt(x3*x3 + y3*y3 + (z3+d)*(z3+d));",
          "p = tan(asin(1) + atan2(d+z3,l));",
          "",
          "my_x = zoom*sin(w)*p;",
          "my_y = zoom*cos(w)*p;",
          "",
          "x = 0.5 + my_x/q6;",
          "y = 0.5 + my_y/q5;",
          "",
          "rad=rad*zoom/d;",
          "",
          "",
          "r=sample;",
          "g=r;",
          "",
          "r2=r;",
          "g2=r;",
