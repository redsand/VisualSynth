  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  ret.xyz = texture(sampler_main, uv_orig).xyz*vec3(.97,1,.97) - vec3(.03,0,.03);\n\nret.z += GetBlur1(uv_orig).z*.45;\nret.x += GetBlur1(uv_orig).z*.05 + GetBlur3(uv_orig).z*.05;\nret.z -= ret.x;\n\nvec2 pixelsize = uTexSize.zw;\nret.y = clamp01(texture( sampler_pw_main,uv_orig).y);\n\nfloat conway = texture( sampler_pw_main, uv_orig + vec2(-1,-1)*pixelsize).y;\n       conway += texture( sampler_pw_main, uv_orig + vec2(0,-1)*pixelsize).y;\n       conway += texture( sampler_pw_main, uv_orig + vec2(1,-1)*pixelsize).y;\n       conway += texture( sampler_pw_main, uv_orig + vec2(-1,0)*pixelsize).y;\n       conway += texture( sampler_pw_main, uv_orig + vec2(1,0)*pixelsize).y;\n       conway += texture( sampler_pw_main, uv_orig + vec2(-1,1)*pixelsize).y;\n       conway += texture( sampler_pw_main, uv_orig + vec2(0,1)*pixelsize).y;\n       conway += texture( sampler_pw_main, uv_orig + vec2(1,1)*pixelsize).y;\n\nfloat test = q5*(1-GetBlur1(uv_orig).y)*(1-GetBlur2(uv_orig).y)*(1-GetBlur3(uv_orig).y);\n\nconway -= texture( sampler_pw_main, uv_orig).x;\n\n\nif (conway > 0) {\nif (clamp01(ret.y) == 0) {\nret.y = floor(test*1.8)*q1;\n}\n}\n\nret.y -= ret.x;\n\nret.xyz -= 1-q2;\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  sampler sampler_rose;\nvec2 uvm = (uv - .5)*q7*(1/(1-rad*.1+q9*(uv.x - .5)+q8*(uv.y - .5)))+.5;\n\nuvm = (uvm - .5);\nuvm = (q10*uvm.xy + vec2(1,-1)*q11*uvm.yx)*uAspect.zw + .5;\n\n\nuvm = abs(fract((uvm+q12)*.5) - .5)*2;\n\n\nvec2 uv3 = texture( sampler_main, uvm).zzz;\nuv3 = (uv3.xy-0.37) * .13 + uvm;\n\n\nret.xyz = texture(sampler_pw_main, uvm).yyy;\n\nret = mix(\nGetBlur1(uv3).z + GetBlur3(uv3).z,\nret,\nret);\n\nret = pow(ret,vec3(.5,1,2)) - .25;\n\nret *= GetBlur3(uv3).y;\n\n//ret = texture(sampler_pw_main, uv).xyz;\n  fragColor = ret;\n}",
    "perFrameCode": [
      "//begin beat code",
      "volume = 0.3*(bass+mid);",
      "beatrate = equal(beatrate,0) + (1-equal(beatrate,0))*(below(volume,0.01) + (1-below(volume,0.01))*beatrate);",
      "lastbeat = lastbeat + equal(lastbeat,0)*time;",
      "meanbass_att = 0.05*(meanbass_att*19 + bass_att);",
      "peakbass_att = max(bass_att,peakbass_att);",
      "beat = above(volume,0.8)*below(peakbass_att - bass_att, 0.05*peakbass_att)*above(time - lastbeat, 0.1 + 0.5*(beatrate - 0.1));",
      "beatrate = max(if(beat,if(below(time-lastbeat,2*beatrate),0.1*(beatrate*9 + time - lastbeat),beatrate),beatrate),0.1);",
      "//Adjust responsiveness: To increase responsiveness, set the \"0.96 and \"0.996\" on the next line to slightly lower values. Higher values decrease responsiveness.",
      "peakbass_att = beat*bass_att + (1-beat)*peakbass_att*(above(time - lastbeat, 2*beatrate)*0.96 + (1-above(time - lastbeat, 2*beatrate))*0.996);",
      "lastbeat = beat*time + (1-beat)*lastbeat;",
      "peakbass_att = max(peakbass_att,1.1*meanbass_att);",
      "//end beat code",
      "",
      "zoom = 1;",
      "decay = 1;",
      "warp = 0;",
      "wave_a = 0;",
      "",
      "tic = min(time-tin,.1);",
      "tin = time;",
      "",
      "q2 = 1;",
      "",
      "q1=1;",
      "vol = vol + ((alt + bass + mid)/3-vol)*tic*1;",
      "q5 = vol*vol*vol*2;",
      "",
      "",
      "q8 = sin(time)*.5;",
      "q9 = sin(time*.75)*.5;",
      "",
      "sw = abs(sw - beat);",
      "an = an + tic*.5*(1-2*sw);",
      "",
      "",
      "q7 = 1+(pow(q8,2) + pow(q9,2))*1;",
      "q10 = sin(an);",
      "q11 = cos(an);",
      "",
      "sp = sp + tic*vol*vol*.5;",
      "",
      "q12 = sp;",
      "",
      "monitor = q12;"
    ],
