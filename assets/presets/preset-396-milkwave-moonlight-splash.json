  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  float corr = uTexSize.xy*texsize_noise_lq.zw;\nvec2 uv1 = vec2(uv.x-0.5,uv.y-0.5);//*uAspect.xy;\n\nvec3 noiseVal =.0*(texture(sampler_noise_lq, uv*.3+.01*rand_frame));\nvec3 Feedback = GetBlur1(1-uv);\n\nvec2 zz = uv1 *uTexSize.xy *.01;\nzz =multiply(zz,mat2(_qa));\nzz = zz.yx;\nvec2 h1 =  cos(zz);\n\nuv += h1*uTexSize.zw * 12;\n\nvec3 crisp = texture(sampler_main,uv);\n\nret = crisp+noiseVal-.01;\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  vec3 ret1, neu, dx, dy;\nvec2 rs,rs2,uv1,uv2, uv3,uv4,dz;\nvec2 uv2;\nfloat ang2, c, s;\nuv -= 0.5;\n//uv *= uAspect.xy;\ndz = 0;\n\nvec2 hor = vec2(uTexSize.z,0)/2;\nvec2 ver = vec2(0,uTexSize.w)/2;\n\nfloat dist = 1;\nfloat inten = 1;\nfloat mask = 0;\nret1 = 0;\nint anz = 4;\nfloat n = 0;\nwhile (n <= anz) {\n    dist = 1-fract(1.0/anz*n+uTime/2); //evtl sqrt !;\n    inten =  sqrt(dist)*(1-dist*dist)*2;\n\n    uv3 = 2*uv*dist + .35 + vec2(q30,0);\n    neu = GetPixel(uv3);\n    dz.x += inten*(GetPixel(uv3+hor)- GetPixel (uv3-hor));\n    dz.y += inten*(GetPixel(uv3+ver)- GetPixel (uv3-ver));\n    ret1 = max(ret1,neu*inten);\nn++;\n}\n\n\n//clouds\nuv += dz/2;\nuv4 = uv-vec2 (0.2,-.1);\nfloat z = .5*clamp(1/(abs(uv.y)+.1),0,12);\nrs = vec2(uv.x * z, z);\nvec3 clouds = lum(texture(sampler_noise_hq,rs+.04*uTime));\nclouds *= clamp01(1-12*uv.y) * 0.1/(.03+length(uv4));\n\nvec3 sky = .1*vec3 (0,0,clamp01(1-3*uv.y));\nret = .03*vec3(0,1,1)+ sky;\nret += clouds;\n\n\nret += 0.1*ret1 + 0.2*q21*ret1 ;\n  fragColor = ret;\n}",
    "perFrameCode": [
      "dec_med = pow (0.9, 30/fps);",
      "dec_slow = pow (0.94, 30/fps);",
      "beat = max (max (bass, mid), treb);",
      "avg = avg*dec_slow + beat*(1-dec_slow);",
      "is_beat = above(beat, .5+avg+peak) * above (time, t0+.2);",
      "t0 = is_beat*time + (1-is_beat)*t0;",
      "peak = is_beat * beat + (1-is_beat)*peak*dec_med;",
      "index = (index + is_beat) %8;",
      "index2 = (index2 + is_beat*bnot(index))%2;",
      "index3 = (index3 + is_beat*bnot(index)*bnot(index2))%3;",
      "",
      "monitor = index4;",
      "",
      "q20 = avg;",
      "q21 = beat;",
      "q22 = peak;",
      "q23 = index;",
      "q24 = is_beat;",
      "vol = bass + mid + treb;",
      "q26 = max (peak,10)/20;",
      "",
      "",
      "k1 =  is_beat*equal(index,0);",
      "p1 =  k1*(p1+1) + (1-k1)*p1;",
      "p2 = dec_med * p2+ (1-dec_med)*p1;",
      "p3 = dec_slow * p3+ (1-dec_slow)*p2;",
      "",
      "rott = p3 * 3.14159265359/4;",
      "",
      "q1 = cos(rott);",
      "q2 = sin(rott);",
      "q3 = -q2;",
      "q4 = q1;",
      "",
      "q27 = 8-index;",
      "q28 = index2;",
      "",
      "movez = movez + .02*30/fps;",
      "q29 = movez*1;",
      "",
      "movex = movex + .004*30/fps*q1;",
      "q30 = movex*1;",
      "",
      "",
      "q5 = rott;",
      "zoom = 1.0;"
    ],
