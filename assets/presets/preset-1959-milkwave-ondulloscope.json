        "perFrameCode": [
          null,
          "//// grid (by flexi)",
          "",
          "i=instance;",
          "ni=num_inst;",
          "",
          "x= (i%ni)/ni;",
          "y= (i%sqrt(ni))/sqrt(ni);",
          "",
          "",
          "/// waves",
          "c1=below(y,.5+.3*treb_att*sin(10*y*x+5*q3));",
          "c2=below(y,.5+.3*bass_att*sin(10*y*x+5*q1));",
          "c3=below(y,.5+.3*mid_att*sin(-10*y*x+5*q2));",
          "",
          "r=if(c1,.4*sin(3.14*x),.8*sin(3.14*y));",
          "g=if(c1,.2+.6*sin(3.14*x),.9*sin(3.14*y));",
          "b=if(c1,.8*sin(1*1.57*x),.3+.7*sin(3.14*y));",
          "",
          "r=if(c2,x,r);",
          "g=if(c2,x,g);",
          "b=if(c2,1,b);",
          "",
          "r=if(c3,.2*sin(3.14*y),r);",
          "g=if(c3,.5*sin(3.14*y),g);",
          "b=if(c3,.3+.7*sin(3.14*y),b);",
          "",
          "border_r=if(bnot(c2)*c1*c3,1,0);",
          "",
          "",
          "//// sun",
          "d1=.012*(2*time%100);",
          "c4=above(x,d1)*below(x,d1+.032)*above(y,.92)*below(y,.95);",
          "",
          "rad=if(c4,.11,rad);",
          "sides=if(c4,50,20);",
          "r=if(c4,.3+.6*y*sin(3.14*x),r);",
          "g=if(c4,.3+.6*y*sin(3.14*x),g);",
          "b=if(c4,.2*b,b);",
          "",
          "",
          "//// moon",
          "c7=above(time%100,49);",
          "",
          "r=if(c4*c7,.4,r);",
          "g=if(c4*c7,.4,g);",
          "b=if(c4*c7,.6,b);",
          "",
          "",
          "/// clouds",
          "c5=above(y,.95);",
          "",
          "rad=if(c5,rad+.7*rad*sin(14*x+q1),rad);",
          "border_r=if(c5,1,border_r);",
          "",
          "",
          "r2=r;",
          "g2=g;",
          "b2=b;",
          "",
          "border_g=border_r;",
          "border_b=border_r;",
          "",
          "",
          "x=.94*x+.03;",
          "y=.93*y+.04;",
          "",
          "",
          "/// waving",
          "x=x+.003*sin(time+i);",
          "y=y+.003*cos(time+i);"
        ],
