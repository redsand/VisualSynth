    "perFrameCode": [
      "decay=.98;",
      "zoom=1.00;",
      "//dx=sin(time*0.01*0.3)*0.001;",
      "//dy=cos(time*0.01*0.15)*0.001;",
      "",
      "basstime=basstime+(bass_att*bass_att)*0.01*(75/fps);",
      "midtime=midtime+(mid_att*mid_att)*0.01*(75/fps);",
      "",
      "qx=sin(basstime*0.01*0.2)*0.2;",
      "cx=0.5+qx;",
      "q4=qx;",
      "",
      "qy=sin(midtime*0.01*0.2)*0.2;",
      "cy=0.5-qy;",
      "q5=qy;",
      "monitor=q4"
    ],
    "perFrameInitCode": [],
    "perPixelCode": [
      "sw = ang/6.2832 + 1;",
      "sw = sw*8;",
      "",
      "bl = equal(int(sw)%2,0);",
      "sw = sw - int(sw);",
      "sw = if(bl,sw,1-sw)*3;",
      "",
      "",
      "rd = pow(rad*.8,.9);",
      "rd = rd*6.2832*2 - (q2+sw)*3;",
      "zm = .01 + .01*sin(rd);",
      "",
      "dx = (x-.5)*zm;",
      "dy = (y-.5)*zm;",
      "cx1 = 0.5+sin(time*0.618)*0.2;",
      "cy1 = 0.5+cos(time*1.618)*0.2;",
      "",
      "dir = bass;",
      "",
      "d = sqrt((x-cx1)*(x-cx1)+(y-cy1)*(y-cy1));",
      "",
      "x1 = if( above(d,0.3),0,  sin(y-cy1)*0.05*dir);",
      "y1 = if( above(d,0.3),0, -sin(x-cx1)*0.05*dir);",
      "",
      "",
      "cx1 = 0.5+sin(time*2.618)*0.3;",
      "cy1 = 0.5+cos(time*3.14)*0.3;",
      "",
      "dir = -mid*2;",
      "",
      "d = sqrt((x-cx1)*(x-cx1)+(y-cy1)*(y-cy1));",
      "",
      "x2 = if( above(d,0.2),0,  sin(y-cy1)*0.05*dir);",
      "y2 = if( above(d,0.2),0, -sin(x-cx1)*0.05*dir);",
      "",
      "cx1 = 0.5+sin(-time*2.618)*0.4;",
      "cy1 = 0.5+cos(-time*1.14)*0.4;",
      "",
      "dir = treb*3;",
      "",
      "d = sqrt((x-cx1)*(x-cx1)+(y-cy1)*(y-cy1));",
      "",
      "x3 = if( above(d,0.1),0,  sin(y-cy1)*0.05*dir);",
      "y3 = if( above(d,0.1),0, -sin(x-cx1)*0.05*dir);",
      "",
      "",
      "dx = x1+x2+x3;",
      "dy = y1+y2+y3;"
    ],
