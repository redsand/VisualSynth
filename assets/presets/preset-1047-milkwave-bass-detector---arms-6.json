          "xp = 0;",
          "yp = 0;",
          "zp = -1;",
          "",
          "//x axis rotation;",
          "ang = (t1 + phase) * 7;",
          "sang = sin(ang);cang = cos(ang);",
          "xq = xp;",
          "yq = yp*cang - zp*sang;",
          "zq = yp*sang + zp*cang;",
          "xp=xq;yp=yq;zp=zq;",
          "",
          "//y axis rotation;",
          "ang = (t1 + phase) * 2.2;",
          "sang = sin(ang);cang = cos(ang);",
