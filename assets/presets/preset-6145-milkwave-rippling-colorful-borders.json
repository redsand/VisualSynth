    "comp": "",
    "perFrameCode": [
      "//wave_r = wave_r + 0.400*( 0.60*sin(0.933*time) + 0.40*sin(1.045*time) );",
      "//wave_g = wave_g + 0.400*( 0.60*sin(0.900*time) + 0.40*sin(0.956*time) );",
      "//wave_b = wave_b + 0.400*( 0.60*sin(0.910*time) + 0.40*sin(0.920*time) );",
      "//zoom = zoom + 0.023*( 0.60*sin(0.339*time) + 0.40*sin(0.276*time) );",
      "//rot = rot + 0.030*( 0.60*sin(0.381*time) + 0.40*sin(0.579*time) );",
      "//decay=decay - 0.01*equal(frame%8,0);",
      "",
      "wave_a = 0;",
      "zoom = 1;",
      "warp = 0;",
      "rot = 0;",
      "",
      "beatchng = if(above(bass, 1.9), 1, 0);",
      "k1 = ob_size = if(equal(beatchng, 1), abs(rand(1)/4), k1);",
      "k2 = ob_r = if(equal(beatchng, 1), abs(rand(1)), k2);",
      "k3 = ob_g = if(equal(beatchng, 1), abs(rand(1)), k3);",
      "k4 = ob_b = if(equal(beatchng, 1), abs(rand(1)), k4);",
      "",
      "q1 = per_vertex_chng = if(equal(beatchng, 1), abs(rand(30)), per_vertex_chng);",
      "",
      "ob_r += sin(time/7);",
      "ob_g += sin(time/8);",
      "ob_b += sin(time/6);"
    ],
    "perFrameInitCode": [],
