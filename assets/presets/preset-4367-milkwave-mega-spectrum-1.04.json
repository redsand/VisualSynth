          "s = sample*3.14*100;",
          "ss = sample*6.28*1000;",
          "",
          "//draw",
          "xs = 0.5*sin(s)*cos(ss)*equal(q5,0) +",
          "(0.6 + 0.1*cos(s))*cos(ss)*equal(q5,1) +",
          "0.5*sin(s)*cos(ss)*equal(q5,2);",
          "ys = 0.5*sin(s)*sin(ss)*equal(q5,0) +",
          "(0.6 + 0.1*cos(s))*sin(ss)*equal(q5,1) +",
          "0.5*sin(s)*sin(ss)*equal(q5,2);",
          "zs = 0.5*cos(s)*equal(q5,0) +",
          "0.1*sin(s)*equal(q5,1) +",
          "0.5*sin(s)*equal(q5,2);",
          "",
          "",
          "",
          "xtor = (0.6 + 0.1*cos(s))*cos(ss);",
          "ytor = (0.6 + 0.1*cos(s))*sin(ss);",
          "ztor = 0.1*sin(s);",
          "",
          "",
          "//rotate x axis",
          "angle = q1*0.3;",
          "yx = ys*cos(angle) - zs*sin(angle);",
          "zx = ys*sin(angle) + zs*cos(angle);",
          "xx = xs;",
          "",
          "//rotate y axis",
          "angle2 = q1*0.5;",
          "xd = xx*cos(angle2) - zx*sin(angle2);",
          "zd = xx*sin(angle2) + zx*cos(angle2);",
          "yd = yx;",
          "",
          "//rotaye z axis",
          "angle3 = q1*0.41;",
          "xn = xd*cos(angle3) - yd*sin(angle3);",
          "yn = xd*sin(angle3) + yd*cos(angle3);",
          "",
          "zd = zd + 2;",
          "",
          "//do that falloff effect",
          "peek1 = (value1 + value2)*10;",
          "",
          "//if sample louder set that to level else decrement level",
