          "level = if(below(level,0),0,level);",
          "",
          "//add to z",
          "zd = zd + 2  + level;",
          "",
          "",
          "x = xn*zd*0.05 + 0.5;",
          "y = yn*zd*0.05*1.2 + 0.5;",
          "",
          "",
          "r = 0.5 + 0.5*sin(q1*1.2 + x + x);",
          "g = 0.5 + 0.5*sin(q1*1.5 + x + y);",
          "b = 0.5 + 0.5*sin(q1*1.36 + y + y);"
        ]
