  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nfloat MinDist (vec2 uvi)\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  float dist, struc, len; vec2 uv0, uv1; vec3 uv2; vec4 box;\nconst mat3 RotMat = mat3(q20,q21,q22,q23,q24,q25,q26,q27,q28);\nconst vec3 CamPos = vec3(q4,q5,q6);\nconst float sustain = .98 - q14, change = q14, ds = q10;\nconst float myzoom = q7, limit = 24, tele=q16;\nfloat GetDist(vec2 uvi) {vec2 tmp; tmp = texture(sampler_pc_main, uvi).gb;\n  return 1-(tmp.y + 1.0/255*tmp.x + ds*.7);}\nvec2 PutDist(float x) {float fg, fb; fg = modf((1-x)*255.0,fb);\n  return (vec2(fg,fb/255.0));}\n{\n   float tmp; vec4 nb; vec4 nb2; vec2 pix;\n   pix = uTexSize.zw*(1.0+length(uvi-0.5)*8.0);\n   tmp = GetDist(uvi);\n   nb.x = GetDist(uvi+pix*vec2(-1,-1));\n   nb.y = GetDist(uvi+pix*vec2(1,-1));\n   nb.z = GetDist(uvi+pix*vec2(1,1));\n   nb.w = GetDist(uvi+pix*vec2(-1,1));\n   nb2.x = GetDist(uvi+pix*vec2(0,-1));\n   nb2.y = GetDist(uvi+pix*vec2(1,0));\n   nb2.z = GetDist(uvi+pix*vec2(0,1));\n   nb2.w = GetDist(uvi+pix*vec2(-1,0));\n   //Eo.S. more efficient usage of min to get min value of all 8 GetDist() calls, removes 11ALU\n   nb = min( nb, nb2 );\n   nb.xy = min( nb.xy, nb.zw );\n   tmp = min( nb.x, nb.y );\n   return tmp;\n}\nvec3 Get1 (vec2 uvi) {vec3 tmp; vec2 pix;\n   return mix(GetPixel(uvi), tmp = GetBlur1(uvi),change*4);} //#\nvec4 mbox (vec3 uvi) {vec3 zz, zz0; float tmp, li;\n  zz = uvi; zz0 = zz+q8; li=0;\n  for (int n = 0; n <= 7; n++) {\n    zz = 2.0*clamp(zz,-1,1)-zz;  tmp = dot(zz,zz);\n    if (tmp <= 0.25) {zz *= 4; li=limit;} else if (tmp <= 1) {zz /= pow(tmp,1);}\n    zz = 2.6*zz + zz0;}\n  return vec4(zz,li);}\nuv1 = (uv-.5)*uAspect.xy*tele;\nuv = (uv-.5)*(1-ds/(GetDist(uv))) + .5;\n\nvec3 noise = fract(8*texture(sampler_noise_lq,uv+rand_frame.yz));\n\ndist = noise.r;\n   if (noise.g > 0.2)\n   {\n       vec3 noiseBiased = noise - vec3( 0.4, 0.5, 0.5 );\n//Eo.S. combine the subtraction on noise to a single vec3 to ensure compiler does the subtraction in a single ALU\n       dist = MinDist( (noiseBiased.zy) * 0.003 +uv ) +  0.008 * (noiseBiased.x) * abs(noiseBiased.y);\n   }\ndist = min(dist,GetDist(uv));\nfloat tdist = dist + pow(dist,3);\nuv2 = multiply(vec3(uv1*tdist,tdist-.0)/myzoom,RotMat)+CamPos;\nuv2 = (fract(uv2/8.0+.5)-.5)*8.0;\nbox = mbox (uv2);\nlen = (length(box.xyz));\nstruc = length(box.xyw)/limit;\nfloat dec = log(1+len/limit)*.02*(1-GetDist(uv));\nif ((dist <= GetDist(uv)) && (len < limit) && (dist > 0.005)){\n ret.r = (1-sustain)*struc+sustain*(Get1(uv).r); ret.gb=  PutDist(dist); }\n else {ret = texture(sampler_fc_main,uv)*vec3(sustain,0,1-dec)-vec3(1.0/255,0,change/6);}\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\n//-------------------------------------------\n//Written by martin\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  #define sat clamp01\nconst vec2 pix = uTexSize.zw;\nfloat glow, tmp, lamp, dist, bdist, b2dist, dist_c;\nvec2 dz, uv1, uv3;\nconst vec3 CamPos = vec3(q4,q5,q6);\nconst float myzoom = q7;\nconst mat3 RotMat = mat3(q20,q21,q22,q23,q24,q25,q26,q27,q28);\nconst vec3 col_struc =  vec3(1,.7,.3) + .2*(rand_preset.xyz-.5);\nstatic vec2 center = vec2 (q1,q2);\nvec3 GetBlurX (vec2 uvi, float x) {return mix(GetPixel(uvi), GetBlur1(uvi), x);}\nfloat GetDist(vec2 uvi)   {return 1-GetPixel(uvi).b;}\nfloat GetDistB(vec2 uvi)  {return 1-GetBlur1(uvi).b;}\nfloat GetDistB2(vec2 uvi) {return 1-GetBlur2(uvi).b;}\nfloat MinDistB (vec2 uvi) {float tmp; vec4 nb; //##nicht ideal\n  tmp = GetDist(uvi);\n  tmp = min(tmp,GetDistB2(uvi)*1) ;\n  return tmp;}\nuv = (uv-.5)*.9 + .5;\nuv1 = (uv-center)*uAspect.xy;\n\ndist = MinDistB(uv);\nbdist = mix(dist,GetDistB(uv),.2);\ndist_c = clamp(GetDistB2 (center),.1,.4); //center distance\n\nvec3 uv2 = multiply(vec3((uv-.5)*MinDistB(uv),MinDistB(uv))/myzoom,RotMat)+CamPos;\nglow = pow(sat(texture(sampler_noise_hq,.02*uv2).r-.6)*2,2);\n//uv += .003*glow*(texture(sampler_noise_mq,uv*2+vec2(0,uTime/4).xy-.5));\n\nfloat focus = sat(abs(GetDistB2(uv)-dist_c)*1+.2);\nfloat struc = GetBlurX(uv,focus).r;\n\nglow = sat(1-exp(-(GetBlur1(uv).r))-.2);\nq18 = 1;\nret = pow(struc,1) * (.2+(1-focus) *mix(dist,1-dist,q18)) * (1+.5*sin(uv2));\nret = mix(ret, vec3(0,1,glow*3), glow);\n\n//distant light\nret += pow(1-GetBlurX(uv,.8).b,3)*(.5+.5*slow_roam_cos) *q19;\n\n//Lamp\nuv3 = uv1;\nlamp = clamp01(1-4*length(uv3))*(struc)*clamp01(1-2*bdist)*1.8;\n//ret += (1-lum(ret))*lamp;\nret = 1-exp((-2)*ret);\n//ret = GetPixel(uv).r;\n  fragColor = ret;\n}",
    "perFrameCode": [
      "fps_ = .0 * fps_ + 1*if(fps<=25,fps,25+.5*(fps-25));",
      "dec_s = 1-.06*30/fps_;",
      "beat = (time >  t0+3); t0 = if(beat, time, t0);",
      "",
      "speed = min(0.2,dist_-.02) * (1+2*avg) *(1-slow*.0)*.7/q7; //#",
      "ds = ds * dec_s + (1-dec_s)*speed*.25/fps_;",
      "RotZ = if (RotZ==0,beat*(rand(100)<20*travel)*(rand(10)/10-.3),",
      "                   bnot(beat*(rand(100)<30))*RotZ);",
      "slow = if (bnot(slow), beat*(rand(1000*avg)<6), bnot(beat*(rand(100)<50)));",
      "look = if (bnot(look), beat*(rand(1000*speed)<12), bnot(beat*(rand(100)<50)));",
      "",
      "//Lamp View",
      "lx = if (beat,rand(150)/200+.15,lx);",
      "ly = if (beat,rand(150)/200+.15,ly);",
      "lampx = lampx * dec_s + (1-dec_s)*if (look,lx,0.5);",
      "lampy = lampy * dec_s + (1-dec_s)*if (look,ly,0.5);",
      "q1 = lampx; q2 = lampy;",
      "",
      "//Position",
      "DirX= reg26; DirY= reg27; DirZ = reg28;",
      "PosX = PosX + ds*DirX ; PosY = PosY + ds*DirY; PosZ = PosZ + ds*DirZ;",
      "q4 = PosX; q5 = PosY; q6 = PosZ;",
      "",
      "angchg = (.2-dist_)*(dist_ < .2)*2;",
      "travel = if (angchg > 0,0,travel+ds);",
      "v1 = v1 * dec_s + (1-dec_s)* RotZ * ds;",
      "v2 = v2 *dec_s + (1-dec_s)*angchg *xslope/fps_;",
      "v3 = v3 *dec_s + (1-dec_s)*(angchg *yslope/fps_ + 2*v1*sin(time*.1));",
      "//v2 = .008;",
      "//push old RotMat",
      "reg30 =reg20; reg31 =reg21; reg32 =reg22;",
      "reg33 =reg23; reg34 =reg24; reg35 =reg25;",
      "reg36 =reg26; reg37 =reg27; reg38 =reg28;",
      "",
      "n = 0; avg = 0;",
      "loop (5,",
      "  n = n+1;",
      "  //new Rot. Mat for infinitesimal angles",
      "  ran1 = rand(100)/100;",
      "  ran2 = rand(100)/200-.25;",
      "  tx = cos(n*1.57+ran2) * (n <= 4)*ran1; ty = sin(n*1.57+ran2) * (n <= 4)*ran1;",
      "  c1 = cos(v1); c2 = cos(v2+ty); c3 = cos(v3+tx);",
      "  s1 = sin(v1); s2 = sin(v2+ty); s3 = sin(v3+tx);",
      "  reg10 = c2*c1; reg11 = c2*s1; reg12 = -s2;",
      "  reg13 = s3*s2*c1 - c3*s1; reg14 = s3*s2*s1 + c3*c1; reg15 = s3*c2;",
      "  reg16 = c3*s2*c1 + s3*s1; reg17 = c3*s2*s1 - s3*c1; reg18 = c3*c2;",
      "",
      "  //pop old RotMat",
      "  reg20 =reg30; reg21 =reg31; reg22 =reg32;",
      "  reg23 =reg33; reg24 =reg34; reg25 =reg35;",
      "  reg26 =reg36; reg27 =reg37; reg28 =reg38;",
      "",
      "  //Multiply new RotMat by old one",
      "  q20 = reg10*reg20 + reg11*reg23 + reg12*reg26;",
      "  q21 = reg10*reg21 + reg11*reg24 + reg12*reg27;",
      "  q22 = reg10*reg22 + reg11*reg25 + reg12*reg28;",
      "  q23 = reg13*reg20 + reg14*reg23 + reg15*reg26;",
      "  q24 = reg13*reg21 + reg14*reg24 + reg15*reg27;",
      "  q25 = reg13*reg22 + reg14*reg25 + reg15*reg28;",
      "  q26 = reg16*reg20 + reg17*reg23 + reg18*reg26;",
      "  q27 = reg16*reg21 + reg17*reg24 + reg18*reg27;",
      "  q28 = reg16*reg22 + reg17*reg25 + reg18*reg28;",
      "",
      "  reg20 =q20; reg21 =q21; reg22 =q22;",
      "  reg23 =q23; reg24 =q24; reg25 =q25;",
      "  reg26 =q26; reg27 =q27; reg28 =q28;",
      "",
      "  //***********BOT*************",
      "  //Coord. Trans. must exactly match def in warp S. !!!!",
      "  dist = 0.002;",
      "  while (exec2(",
      "    uvx = reg26*dist/q7; uvy = reg27*dist/q7; uvz = reg28*dist/q7;",
      "    uvx += PosX; uvy += PosY; uvz += PosZ;",
      "    uvx = 8.0*((uvx/8+30.5 - int(uvx/8+30.5))-.5);",
      "    uvy = 8.0*((uvy/8+30.5 - int(uvy/8+30.5))-.5);",
      "    uvz = 8.0*((uvz/8+30.5 - int(uvz/8+30.5))-.5);",
      "    uvx0 = uvx+q8; uvy0 = uvy+q8; uvz0 = uvz+q8;",
      "    loop (7+1,",
      "      uvx = if (uvx > 1, 2-uvx, if(uvx < -1, -2-uvx, uvx));",
      "      uvy = if (uvy > 1, 2-uvy, if(uvy < -1, -2-uvy, uvy));",
      "      uvz = if (uvz > 1, 2-uvz, if(uvz < -1, -2-uvz, uvz));",
      "      slen = uvx*uvx + uvy*uvy + uvz*uvz;",
      "      uvx = if (slen < 0.25, uvx*4, if (slen < 1, uvx/slen, uvx)) *2.6 + uvx0;",
      "      uvy = if (slen < 0.25, uvy*4, if (slen < 1, uvy/slen, uvy)) *2.6 + uvy0;",
      "      uvz = if (slen < 0.25, uvz*4, if (slen < 1, uvz/slen, uvz)) *2.6 + uvz0;",
      "    );",
      "    len = sqrt(uvx*uvx + uvy*uvy + uvz*uvz);",
      "    dist *= 1.1;",
      "  ,(dist < 0.6)*(len > 30)));",
      "  megabuf(n) = megabuf(n)*dec_s + (1-dec_s)*dist; //stores the 4 trial points",
      "  avg = avg+abs(megabuf(n)/5);",
      "); //end loop 5",
      "",
      "n = 0; avg = 0; loop (5, n=n+1; avg = avg+abs(megabuf(n)/5));",
      "",
      "xslope = min(max(2/avg*(megabuf(1)-megabuf(3)),-3),3);",
      "yslope = min(max(2/avg*(megabuf(4)-megabuf(2)),-3),3);",
      "monitor = avg;",
      "dist_ = dist_*dec_s + (1-dec_s)*dist;",
      "",
      "q10 = ds*q7; //compensation of lin. movement in GetDist and zoom uv",
      "q14 = 1*abs(ds) + 2*(abs(v1) + abs(v2) + abs(v3)) + 1.0/255 + start*.05;",
      "q19 = .6 + .4*sin(time*.02+cran0*6); //brightness backgd",
      "start = start * .9;",
      "q11 = v1; q12 = v2; q13 = v3;",
      "//forward comp. of Rotation",
      "monitor = q16;"
    ],
    "perFrameInitCode": [
      "",
      "//******** INITIALIZATION *********",
      "//---------- some global vars, do not change -------------",
      "avg = 0.01;",
      "q7 = .25; //MyZoom",
      "q8 =  rand(2.0)-1.0; //fractal modifier",
      "//q8 = 1; //#",
      "q16 = 1 + rand(2); //Tele ; rather fish eye",
      "//q16 = 1; //#",
      "q18 = rand(0.8)+.1; //brightness balance back/front",
      "q30 = 1; //logarithmic Z-Dist storage; unused",
      "q31 =128;",
      "start = 1; travel = 0; RotZ = 0; look = 0; slow = 0; t0 = time+3; lampx = .5; lampy = .5;",
      "cran0 = rand(1);",
      "n = 0; loop (10000, gmegabuf(n)=0; n=n+1; );",
      "n = 0; loop (10000,  megabuf(n)=0; n=n+1; );",
      "trelx = 0;  trely = 0; trelz = 0;",
      "reg20 = 1; reg21 = 0; reg22 = 0; reg23 = 0; reg24 = 1; reg25 = 0; reg26 = 0; reg27 = 0; reg28 = 1;",
      "",
      "//Find random starting point",
      "while (exec2(",
      "  ran1 = rand(800)/100;  ran2 = rand(800)/100;  ran3 = rand(800)/100;",
      "  PosX = rand(5)-2;   PosY = rand(5)-2;   PosZ = rand(5)-2;",
      "",
      "//  PosX = 3.3; PosY = 2; PosZ = -2; ran1 = 0; ran2 = 0; ran3 = 0; //#",
      "",
      "  c1 = cos(ran1); c2 = cos(ran2); c3 = cos(ran3);",
      "  s1 = sin(ran1); s2 = sin(ran2); s3 = sin(ran3);",
      "",
      "  reg20 = c2*c1; reg21 = c2*s1; reg22 = -s2;",
      "  reg23 = s3*s2*c1 - c3*s1; reg24 = s3*s2*s1 + c3*c1; reg25 = s3*c2;",
      "  reg26 = c3*s2*c1 + s3*s1; reg27 = c3*s2*s1 - s3*c1; reg28 = c3*c2;",
      "",
      "  //***********BOT*************",
      "  //Coord. Trans. must exactly match def in warp S. !!!!",
      "  dist = 0.001;",
      "  while (exec2(",
      "    uvx = reg26*dist/q7; uvy = reg27*dist/q7; uvz = reg28*dist/q7;",
      "    uvx += PosX; uvy += PosY; uvz += PosZ;",
      "    uvx = 8.0*((uvx/8+30.5 - int(uvx/8+30.5))-.5);",
      "    uvy = 8.0*((uvy/8+30.5 - int(uvy/8+30.5))-.5);",
      "    uvz = 8.0*((uvz/8+30.5 - int(uvz/8+30.5))-.5);",
      "    uvx0 = uvx+q8; uvy0 = uvy+q8; uvz0 = uvz+q8;",
      "    loop (7+1,",
      "      uvx = if (uvx > 1, 2-uvx, if(uvx < -1, -2-uvx, uvx));",
      "      uvy = if (uvy > 1, 2-uvy, if(uvy < -1, -2-uvy, uvy));",
      "      uvz = if (uvz > 1, 2-uvz, if(uvz < -1, -2-uvz, uvz));",
