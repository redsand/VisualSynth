  "_shaderData": {
    "warp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  #define MyGet GetPixel //GetBlur1\n// GROW EFFECT - bright pixels spread radially outward.\n    // BE CAREFUL - this can really thrash the texture cache! (SLOW)\n    float grad_rad = 2.5;  //TWEAK\n    float str = 2.0;      //TWEAK\n    vec3 d = vec3(uTexSize.zw, 0) * grad_rad;\n    vec4 lums = 0;\n    lums.x = lum( MyGet(uv + uTexSize.zw*d.xz) );\n    lums.y = lum( MyGet(uv - uTexSize.zw*d.xz) );\n    lums.z = lum( MyGet(uv + uTexSize.zw*d.zy) );\n    lums.w = lum( MyGet(uv - uTexSize.zw*d.zy) );\n    vec2 grad = vec2(lums.x-lums.y, lums.z-lums.w)*str*1000/grad_rad;\n    grad = (clamp01(grad*0.5+0.5)*2-1)*1.4;\n\n    // sample previous uFrame\n    ret = texture( sampler_fc_main, uv + grad*uTexSize.zw ).xyz;\n\nvec2 uv_echo = (uv - 0.5)*vec2(-1,-1) + 0.5;\n\n    vec4 lums2 = 0;\n    lums2.x = lum( MyGet(uv_echo + uTexSize.zw*d.xz) );\n    lums2.y = lum( MyGet(uv_echo - uTexSize.zw*d.xz) );\n    lums2.z = lum( MyGet(uv_echo + uTexSize.zw*d.zy) );\n    lums2.w = lum( MyGet(uv_echo - uTexSize.zw*d.zy) );\n    vec2 grad2 = vec2(lums2.x-lums2.y, lums2.z-lums2.w)*str*1000/grad_rad;\n    grad2 = (clamp01(grad2*0.5+0.5)*2-1)*1.4;\n\nvec3 ret2 = texture(sampler_fc_main, uv_echo + grad2*uTexSize.zw).xyz;\n\nret = mix(ret,ret2,0.50);\n\n    // darken (decay) over uTime\n    ret *= 0.95; //or try: ret -= 0.004;\n  fragColor = ret;\n}",
    "comp": "#version 300 es\nprecision highp float;\n\n// VisualSynth uniforms\nuniform float uTime;\nuniform float uFrame;\nuniform float uFps;\nuniform float uRms;\n\n// Audio uniforms\nuniform float audioLow;      // bass\nuniform float audioLowSmooth; // bass_att\nuniform float audioMid;      // mid\nuniform float audioMidSmooth; // mid_att\nuniform float audioHigh;     // treb\nuniform float audioHighSmooth; // treb_att\n\n// Screen uniforms\nuniform float uAspectX;\nuniform float uAspectY;\nuniform vec2 uAspect;\nuniform vec2 uTexSize;\n\n// Random values\nuniform vec2 uRandomPreset;\nuniform vec2 uRandomFrame;\n\n// Input from vertex shader\nin vec2 vUv;\nin vec2 vUvOriginal;\nin float vRadius;\nin float vAngle;\n\n// Output\nout vec4 fragColor;\n\n// Textures\nuniform sampler2D sampler_main;\nuniform sampler2D sampler_noise_lq;\nuniform sampler2D sampler_noise_mq;\nuniform sampler2D sampler_noise_hq;\nuniform sampler2D sampler_blur1;\nuniform sampler2D sampler_blur2;\nuniform sampler2D sampler_blur3;\n\n// Helper functions\nfloat clamp01(float x) { return clamp(x, 0.0, 1.0); }\nvec2 clamp01(vec2 x) { return clamp(x, vec2(0.0), vec2(1.0)); }\nvec3 clamp01(vec3 x) { return clamp(x, vec3(0.0), vec3(1.0)); }\nvec4 clamp01(vec4 x) { return clamp(x, vec4(0.0), vec4(1.0)); }\n\n// Texture helper functions\nvec3 GetPixel(vec2 uv) { return texture(sampler_main, uv).xyz; }\nvec3 GetBlur1(vec2 uv) { return texture(sampler_blur1, uv).xyz; }\nvec3 GetBlur2(vec2 uv) { return texture(sampler_blur2, uv).xyz; }\nvec3 GetBlur3(vec2 uv) { return texture(sampler_blur3, uv).xyz; }\n\nvoid main() {\n  vec4 ret = vec4(0.0);\n  vec2 uv = vUv;\n  vec2 uv_orig = vUvOriginal;\n  float rad = vRadius;\n  float ang = vAngle;\n  uv *= 0.5;\n    ret = texture(sampler_main, uv).xyz;\n    ret = max(ret, texture(sampler_main,uv + vec2(0.5,0)).xyz);\n    ret = max(ret, texture(sampler_main,uv + vec2(0,0.5)).xyz);\n    ret = max(ret, texture(sampler_main,uv + vec2(0.5,0.5)).xyz);\n    ret *= 1.666;\n  fragColor = ret;\n}",
